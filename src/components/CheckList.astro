---
import Icon from './Icon.astro';
interface Props { items: readonly string[]; columns?: 1 | 2; tone?: 'dark' | 'light'; class?: string }
const { items, columns = 1, tone = 'dark', class: cls = '' } = Astro.props;
---
<ul class:list={['grid gap-x-8 gap-y-3', columns === 2 && 'sm:grid-cols-2', cls]}>
  {items.map((p) => (
    <li class:list={['flex items-start gap-3', tone === 'light' ? 'text-cream-50/90' : 'text-ink-800']}>
      <Icon name="check" size={18} class:list={['mt-1 shrink-0', tone === 'light' ? 'text-ochre-300' : 'text-clay-600']} /><span>{p}</span>
    </li>
  ))}
</ul>
