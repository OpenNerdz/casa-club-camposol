---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { title: string; text: string; cta1: string; cta2: string; image?: string }
const { title, text, cta1, cta2, image } = Astro.props;
---
<section class="container-x py-8">
  <div class="relative isolate overflow-hidden rounded-xl2 bg-green-900 px-6 py-16 text-center text-white shadow-soft sm:px-12 sm:py-20">
    {image && <img src={image} alt="" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-40" loading="lazy" decoding="async" />}
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-green-950/90 via-green-900/80 to-green-800/70"></div>
    <div class="absolute -right-24 -top-24 -z-10 h-72 w-72 rounded-full bg-sol-500/30 blur-3xl"></div>
    <h2 class="text-3xl font-medium sm:text-5xl [text-wrap:balance]">{title}</h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-sand-100/85">{text}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={site.whatsappHref} class="btn-accent" target="_blank" rel="noopener"><Icon name="whatsapp" size={16} /> {cta1}</a>
      <a href={site.phoneHref} class="btn-ghost"><Icon name="phone" size={16} /> {cta2}</a>
    </div>
  </div>
</section>
