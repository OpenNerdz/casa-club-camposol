---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { useTranslations, localePath, withBase, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const hours = site.hours[lang];
---
<footer class="relative mt-24 bg-green-950 text-sand-100">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sol-400/70 to-transparent"></div>
  <div class="container-x grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href={localePath(lang, '/')} class="flex items-center gap-3">
        <img src={withBase('/images/logo-mark.svg')} alt="" width="44" height="44" class="h-11 w-11" />
        <span class="font-display text-2xl leading-none">Casa Club<span class="mt-1 block font-sans text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-sol-300">Camposol</span></span>
      </a>
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-sand-200/80">{t('footer.blurb')}</p>
      <div class="mt-5 flex gap-3">
        {site.social.facebook && <a href={site.social.facebook} class="rounded-full bg-white/10 p-2.5 transition hover:bg-white/20" aria-label="Facebook" rel="noopener" target="_blank"><Icon name="facebook" size={18} /></a>}
        {site.social.instagram && <a href={site.social.instagram} class="rounded-full bg-white/10 p-2.5 transition hover:bg-white/20" aria-label="Instagram" rel="noopener" target="_blank"><Icon name="instagram" size={18} /></a>}
        {site.whatsappHref && <a href={site.whatsappHref} class="rounded-full bg-white/10 p-2.5 transition hover:bg-white/20" aria-label="WhatsApp" rel="noopener" target="_blank"><Icon name="whatsapp" size={18} /></a>}
      </div>
    </div>

    <div>
      <h3 class="eyebrow text-sol-300">{t('footer.visit')}</h3>
      <address class="mt-4 not-italic text-sm leading-relaxed text-sand-200/90">
        {site.address.lines.map((l) => <span class="block">{l}</span>)}
      </address>
      <a href={site.mapsUrl} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-sol-300 hover:text-sol-200"><Icon name="pin" size={16} /> {t('footer.directions')}</a>
    </div>

    <div>
      <h3 class="eyebrow text-sol-300">{t('footer.hours')}</h3>
      <ul class="mt-4 space-y-1.5 text-sm text-sand-200/90">
        {hours.map((h) => <li class="flex justify-between gap-4"><span>{h.label}</span><span class="text-right">{h.value}</span></li>)}
      </ul>
      <p class="mt-3 text-xs text-sand-200/60">{t('footer.hoursNote')}</p>
    </div>

    <div>
      <h3 class="eyebrow text-sol-300">{t('footer.contact')}</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href={site.phoneHref} class="inline-flex items-center gap-2 hover:text-white"><Icon name="phone" size={16} /> {site.phoneDisplay}</a></li>
        {site.whatsappHref && <li><a href={site.whatsappHref} class="inline-flex items-center gap-2 hover:text-white"><Icon name="whatsapp" size={16} /> WhatsApp</a></li>}
        {site.email && <li><a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 hover:text-white"><Icon name="mail" size={16} /> {site.email}</a></li>}
      </ul>
      <nav class="mt-6 flex flex-wrap gap-x-4 gap-y-1 text-xs text-sand-200/70" aria-label="Legal">
        <a href={localePath(lang, '/legal/')} class="hover:text-white">{t('footer.legal')}</a>
        <a href={localePath(lang, '/privacy/')} class="hover:text-white">{t('footer.privacy')}</a>
      </nav>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-5 text-xs text-sand-200/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.legalName}. {t('footer.rights')}</p>
      <p>{t('footer.tagline')}</p>
    </div>
  </div>
</footer>
