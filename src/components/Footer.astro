---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import HoursList from './HoursList.astro';
import { site, whatsappBookingHref } from '../data/site';
import { useTranslations, localePath, em, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const explore = [
  { href: localePath(lang, '/restaurant/'), label: t('nav.restaurant') },
  { href: localePath(lang, '/golf/'), label: t('nav.golf') },
  { href: localePath(lang, '/events/'), label: t('nav.events') },
  { href: localePath(lang, '/gallery/'), label: t('nav.gallery') },
  { href: localePath(lang, '/contact/'), label: t('nav.contact') },
];
const social = [
  { href: site.social.facebook, icon: 'facebook', label: 'Facebook' },
  { href: site.social.instagram, icon: 'instagram', label: 'Instagram' },
  { href: site.whatsappHref, icon: 'whatsapp', label: 'WhatsApp' },
];
const heading = 'font-sans text-[0.75rem] font-semibold uppercase tracking-[0.18em] text-ochre-300';
---
<footer class="on-dark mt-16 bg-pine-950 text-cream-50 sm:mt-20">
  <!-- Sign-off: the last call to action on every page -->
  <div class="container-x"><div class="grid gap-8 border-b border-cream-50/10 py-16 sm:py-20 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <p class="display text-[clamp(2.75rem,1.8rem+3.6vw,5.5rem)] leading-[0.95]" set:html={em(t('footer.signoff'))} />
      <p class="mt-5 max-w-xl text-lg text-cream-50/75">{t('footer.signoffText')}</p>
    </div>
    <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
      <a href={`${localePath(lang, '/contact/')}#enquiry`} data-book class="btn-light">{t('cta.book')} <Icon name="arrow" size={16} /></a>
      <a href={whatsappBookingHref(lang)} target="_blank" rel="noopener" class="btn-ghost"><Icon name="whatsapp" size={16} /> WhatsApp</a>
    </div>
  </div></div>

  <div class="container-x grid gap-12 py-14 sm:grid-cols-2 lg:grid-cols-12">
    <div class="lg:col-span-3">
      <a href={localePath(lang, '/')} class="inline-block"><Logo tone="light" /></a>
      <p class="mt-5 max-w-xs text-[0.9375rem] leading-relaxed text-cream-50/70">{t('footer.blurb')}</p>
      <ul class="mt-6 flex gap-2">
        {social.map((s) => <li><a href={s.href} class="grid h-11 w-11 place-items-center rounded-full border border-cream-50/15 transition-colors hover:border-ochre-300 hover:text-ochre-300" aria-label={s.label} rel="noopener" target="_blank"><Icon name={s.icon} size={18} /></a></li>)}
      </ul>
    </div>

    <div class="lg:col-span-2">
      <h2 class={heading}>{t('footer.explore')}</h2>
      <ul class="mt-5 space-y-2.5 text-[0.9375rem]">
        {explore.map((l) => <li><a href={l.href} class="text-cream-50/80 transition-colors hover:text-ochre-300">{l.label}</a></li>)}
      </ul>
    </div>

    <div class="lg:col-span-4">
      <h2 class={heading}>{t('footer.visit')}</h2>
      <address class="mt-5 text-[0.9375rem] not-italic leading-relaxed text-cream-50/80">
        {site.address.lines.map((l) => <span class="block">{l}</span>)}
      </address>
      <a href={site.directionsUrl} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-2 text-[0.9375rem] font-semibold text-ochre-300 hover:text-ochre-100"><Icon name="navigation" size={16} /> {t('cta.directions')}</a>
      <ul class="mt-6 space-y-2 text-[0.9375rem]">
        <li><a href={site.phoneHref} class="inline-flex items-center gap-2.5 text-cream-50/80 hover:text-cream-50"><Icon name="phone" size={16} class="text-ochre-300" /> {site.phoneDisplay}</a></li>
        <li><a href={`mailto:${site.email}`} class="inline-flex items-center gap-2.5 text-cream-50/80 [overflow-wrap:anywhere] hover:text-cream-50"><Icon name="mail" size={16} class="shrink-0 text-ochre-300" /> {site.email}</a></li>
      </ul>
    </div>

    <div class="lg:col-span-3">
      <h2 class={heading}>{t('footer.hours')}</h2>
      <HoursList lang={lang} tone="light" class="mt-3" />
      <p class="mt-3 text-xs text-cream-50/55">{t('footer.hoursNote')}</p>
    </div>
  </div>

  <!-- Bottom padding on phones clears the fixed action bar -->
  <div class="border-t border-cream-50/10 pb-[calc(4.25rem+env(safe-area-inset-bottom))] lg:pb-0">
    <div class="container-x flex flex-col gap-3 py-6 text-xs text-cream-50/55 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.legalName} {t('footer.rights')}</p>
      <nav class="flex gap-5" aria-label="Legal">
        <a href={localePath(lang, '/legal/')} class="hover:text-cream-50">{t('footer.legal')}</a>
        <a href={localePath(lang, '/privacy/')} class="hover:text-cream-50">{t('footer.privacy')}</a>
      </nav>
    </div>
  </div>
</footer>
