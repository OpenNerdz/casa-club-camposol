---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, whatsappBookingHref } from '../data/site';
import { useTranslations, localePath, switchLang, type Lang } from '../i18n/utils';
interface Props { lang: Lang; tone: 'dark' | 'light' }
const { lang, tone } = Astro.props;
const t = useTranslations(lang);
const nav = [
  { href: localePath(lang, '/restaurant/'), label: t('nav.restaurant') },
  { href: localePath(lang, '/golf/'), label: t('nav.golf') },
  { href: localePath(lang, '/events/'), label: t('nav.events') },
  { href: localePath(lang, '/gallery/'), label: t('nav.gallery') },
  { href: localePath(lang, '/contact/'), label: t('nav.contact') },
];
const other: Lang = lang === 'en' ? 'es' : 'en';
const otherHref = switchLang(Astro.url, other);
const current = Astro.url.pathname;
const enquiryHref = `${localePath(lang, '/contact/')}#enquiry`;
---
<header id="site-header" class="site-header fixed inset-x-0 top-0 z-50" data-tone={tone} data-scrolled="false" data-open="false">
  <div class="container-x flex h-[4.5rem] items-center gap-4 lg:h-20">
    <a href={localePath(lang, '/')} class="mr-auto" aria-label={`${site.name}, ${t('nav.home')}`}><Logo /></a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label={t('nav.main')}>
      {nav.map((n) => (
        <a href={n.href} aria-current={current === n.href ? 'page' : undefined}
           class="relative rounded-full px-3.5 py-2 text-[0.9375rem] font-semibold opacity-85 transition hover:bg-current/10 hover:opacity-100 aria-[current=page]:opacity-100 aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-0 aria-[current=page]:after:-bottom-0.5 aria-[current=page]:after:mx-auto aria-[current=page]:after:h-1 aria-[current=page]:after:w-1 aria-[current=page]:after:rounded-full aria-[current=page]:after:bg-clay-500">{n.label}</a>
      ))}
    </nav>

    <a href={otherHref} hreflang={other} lang={other}
       class="grid h-10 min-w-10 place-items-center rounded-full border border-current/25 px-2.5 text-xs font-bold tracking-widest transition-colors hover:border-current/60"
       aria-label={other === 'es' ? 'Ver en español' : 'View in English'}>{other.toUpperCase()}</a>
    <a href={enquiryHref} data-book class="btn-primary hidden h-11 sm:inline-flex">{t('cta.book')}</a>
    <button id="menu-toggle" type="button" class="-mr-2 grid h-11 w-11 place-items-center rounded-full lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label={t('nav.menu')} data-label-open={t('nav.menu')} data-label-close={t('nav.close')}>
      <Icon name="menu" size={26} class="icon-open" />
      <Icon name="close" size={26} class="icon-close hidden" />
    </button>
  </div>

</header>

<!-- Outside <header>: its backdrop-filter would otherwise trap this fixed panel inside the bar -->
<div id="mobile-menu" hidden class="fixed inset-x-0 bottom-0 top-[4.5rem] z-[45] overflow-y-auto bg-pine-950 text-cream-50 lg:hidden">
  <nav class="container-x flex min-h-full flex-col pb-10 pt-4" aria-label={t('nav.main')}>
    <ul class="divide-y divide-cream-50/10 border-b border-cream-50/10">
      {nav.map((n) => (
        <li><a href={n.href} aria-current={current === n.href ? 'page' : undefined} class="block py-4 text-2xl font-bold tracking-tight text-cream-50 aria-[current=page]:text-ochre-300">{n.label}</a></li>
      ))}
    </ul>
    <div class="mt-auto grid gap-3 pt-8">
      <a href={whatsappBookingHref(lang)} class="btn-primary h-14 text-base" target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> {t('cta.book')}</a>
      <a href={site.phoneHref} class="btn-glass h-14 text-base"><Icon name="phone" size={18} /> {site.phoneDisplay}</a>
    </div>
  </nav>
</div>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const onScroll = () => { header.dataset.scrolled = String(window.scrollY > 8); };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  function setOpen(open: boolean) {
    menu.hidden = !open;
    header.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? toggle.dataset.labelClose! : toggle.dataset.labelOpen!);
    toggle.querySelector('.icon-open')!.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')!.classList.toggle('hidden', !open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }
  toggle.addEventListener('click', () => setOpen(menu.hidden));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setOpen(false); toggle.focus(); } });
  // Close if the viewport grows past the mobile breakpoint while open
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>
