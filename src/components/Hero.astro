---
import Icon from './Icon.astro';
interface Props { image: string; alt?: string; eyebrow?: string; title: string; sub?: string; cta1?: { href: string; label: string; icon?: string }; cta2?: { href: string; label: string; icon?: string }; compact?: boolean; align?: 'left' | 'center' }
const { image, alt = '', eyebrow, title, sub, cta1, cta2, compact = false, align = 'left' } = Astro.props;
---
<section class:list={['relative isolate flex items-end overflow-hidden bg-green-950 text-white', compact ? 'min-h-[62vh] sm:min-h-[56vh]' : 'min-h-[92vh]']}>
  <img src={image} alt={alt} class="absolute inset-0 -z-20 h-full w-full object-cover" fetchpriority="high" decoding="async" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-green-950/90 via-green-950/40 to-green-950/20"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-green-950/50 to-transparent"></div>
  <div class:list={['container-x relative pb-16 pt-40 sm:pb-24', align === 'center' && 'text-center']}>
    <div class:list={['max-w-3xl', align === 'center' && 'mx-auto']}>
      {eyebrow && <p class="eyebrow text-sol-300 reveal is-visible">{eyebrow}</p>}
      <h1 class="mt-4 text-4xl font-medium leading-[1.02] sm:text-6xl lg:text-7xl [text-wrap:balance]">{title}</h1>
      {sub && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-sand-100/90 sm:text-xl">{sub}</p>}
      {(cta1 || cta2) && (
        <div class:list={['mt-9 flex flex-wrap gap-3', align === 'center' && 'justify-center']}>
          {cta1 && <a href={cta1.href} class="btn-accent">{cta1.icon && <Icon name={cta1.icon} size={16} />}{cta1.label}</a>}
          {cta2 && <a href={cta2.href} class="btn-ghost">{cta2.icon && <Icon name={cta2.icon} size={16} />}{cta2.label}</a>}
        </div>
      )}
    </div>
  </div>
</section>
