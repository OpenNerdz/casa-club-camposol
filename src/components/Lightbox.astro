---
// Photo viewer for <a data-lightbox href="full.webp" data-caption="…"> links on the page.
// A native <dialog> gives focus trapping and Esc for free; arrows and swipes move between photos.
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
const btn = 'grid h-12 w-12 place-items-center rounded-full bg-cream-50/10 text-cream-50 transition-colors hover:bg-cream-50/20';
---
<dialog id="lightbox" aria-label={t('lb.label')} class="m-0 h-dvh max-h-none w-screen max-w-none bg-pine-950/97 p-0 text-cream-50 backdrop:bg-transparent">
  <figure class="flex h-full flex-col items-center justify-center gap-4 px-4 pb-24 pt-16 sm:px-20 sm:pb-16">
    <img id="lb-img" alt="" class="min-h-0 max-w-full flex-1 rounded-xl object-contain" />
    <figcaption id="lb-cap" class="max-w-xl text-center text-sm text-cream-50/80"></figcaption>
  </figure>
  <p id="lb-count" class="absolute left-5 top-5 text-sm tabular-nums text-cream-50/60"></p>
  <button type="button" data-close class:list={[btn, 'absolute right-4 top-3']} aria-label={t('lb.close')}><Icon name="close" size={22} /></button>
  <button type="button" data-step="-1" class:list={[btn, 'absolute bottom-6 left-1/2 -translate-x-[calc(100%+0.5rem)] sm:bottom-auto sm:left-5 sm:top-1/2 sm:-translate-x-0 sm:-translate-y-1/2']} aria-label={t('lb.prev')}><Icon name="left" size={24} /></button>
  <button type="button" data-step="1" class:list={[btn, 'absolute bottom-6 left-1/2 translate-x-2 sm:bottom-auto sm:left-auto sm:right-5 sm:top-1/2 sm:translate-x-0 sm:-translate-y-1/2']} aria-label={t('lb.next')}><Icon name="right" size={24} /></button>
</dialog>

<script>
  const box = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lb-img') as HTMLImageElement;
  const cap = document.getElementById('lb-cap')!;
  const count = document.getElementById('lb-count')!;
  let i = 0;
  // Only the photos currently shown (the gallery filter hides some)
  const links = () => [...document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')].filter((a) => a.offsetParent !== null);

  function show(n: number) {
    const list = links();
    i = (n + list.length) % list.length;
    const a = list[i];
    img.src = a.href; img.alt = a.dataset.caption ?? ''; cap.textContent = a.dataset.caption ?? '';
    count.textContent = `${i + 1} / ${list.length}`;
    if (!box.open) box.showModal();
  }

  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-lightbox]');
    if (!a || typeof box.showModal !== 'function') return;
    e.preventDefault();
    show(links().indexOf(a));
  });
  box.querySelector('[data-close]')!.addEventListener('click', () => box.close());
  box.querySelectorAll<HTMLElement>('[data-step]').forEach((b) => b.addEventListener('click', () => show(i + Number(b.dataset.step))));
  box.addEventListener('click', (e) => { if (e.target === box || (e.target as Element).tagName === 'FIGURE') box.close(); });
  box.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
  box.addEventListener('close', () => img.removeAttribute('src'));

  // Swipe on touch screens
  let x0: number | null = null;
  box.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  box.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0; x0 = null;
    if (Math.abs(dx) > 50) show(i + (dx < 0 ? 1 : -1));
  });
</script>
