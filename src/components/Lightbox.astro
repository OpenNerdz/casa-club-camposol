---
// Attach to any <a data-lightbox href="full.jpg"> elements on the page.
---
<div id="lightbox" class="fixed inset-0 z-[90] hidden items-center justify-center bg-ink-900/95 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Image viewer">
  <button id="lb-close" class="absolute right-4 top-4 rounded-full bg-white/10 p-3 text-white hover:bg-white/20" aria-label="Close">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </button>
  <button id="lb-prev" class="absolute left-3 top-1/2 -translate-y-1/2 rounded-full bg-white/10 p-3 text-white hover:bg-white/20" aria-label="Previous"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
  <button id="lb-next" class="absolute right-3 top-1/2 -translate-y-1/2 rounded-full bg-white/10 p-3 text-white hover:bg-white/20" aria-label="Next"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>
  <figure class="max-h-full max-w-6xl">
    <img id="lb-img" src="" alt="" class="max-h-[82vh] w-auto max-w-full rounded-xl object-contain shadow-2xl" />
    <figcaption id="lb-cap" class="mt-3 text-center text-sm text-sand-200/80"></figcaption>
  </figure>
</div>
<script>
  const box = document.getElementById('lightbox')!;
  const img = document.getElementById('lb-img') as HTMLImageElement;
  const cap = document.getElementById('lb-cap')!;
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]'));
  let i = 0;
  const show = (n: number) => {
    i = (n + links.length) % links.length;
    const a = links[i];
    img.src = a.href; img.alt = a.dataset.caption ?? ''; cap.textContent = a.dataset.caption ?? '';
    box.classList.remove('hidden'); box.classList.add('flex'); document.body.style.overflow = 'hidden';
  };
  const hide = () => { box.classList.add('hidden'); box.classList.remove('flex'); document.body.style.overflow = ''; };
  links.forEach((a, n) => a.addEventListener('click', (e) => { e.preventDefault(); show(n); }));
  document.getElementById('lb-close')!.addEventListener('click', hide);
  document.getElementById('lb-prev')!.addEventListener('click', () => show(i - 1));
  document.getElementById('lb-next')!.addEventListener('click', () => show(i + 1));
  box.addEventListener('click', (e) => { if (e.target === box) hide(); });
  document.addEventListener('keydown', (e) => {
    if (box.classList.contains('hidden')) return;
    if (e.key === 'Escape') hide(); if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1);
  });
</script>
