---
// Mark + wordmark. The text takes the surrounding colour, so it works on light and dark.
import { withBase } from '../i18n/utils';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class:list={['flex items-center gap-3', cls]}>
  <img src={withBase('/images/logo-mark.svg')} alt="" width="44" height="44" class="h-11 w-11 shrink-0" />
  <span class="leading-none">
    <span class="block text-[1.2rem] font-extrabold tracking-[-0.03em]">Casa Club</span>
    <span class="mt-1 block text-[0.6rem] font-bold uppercase tracking-[0.3em] opacity-70">Camposol</span>
  </span>
</span>
