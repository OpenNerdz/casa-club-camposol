---
import { withBase } from '../i18n/utils';
interface Props { tone?: 'dark' | 'light'; class?: string }
const { tone = 'dark', class: cls = '' } = Astro.props;
---
<span class:list={['flex items-center gap-3', cls]}>
  <img src={withBase('/images/logo-mark.svg')} alt="" width="44" height="44" class="h-11 w-11 shrink-0" />
  <span class="leading-none">
    <span class:list={['block text-[1.2rem] font-extrabold tracking-[-0.03em]', tone === 'dark' ? 'text-pine-950' : 'text-cream-50']}>Casa Club</span>
    <span class:list={['mt-1 block text-[0.6rem] font-bold uppercase tracking-[0.3em]', tone === 'dark' ? 'text-clay-700' : 'text-ochre-300']}>Camposol</span>
  </span>
</span>
