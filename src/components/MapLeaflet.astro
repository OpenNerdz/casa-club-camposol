---
// Interactive map, loaded only when it scrolls near the viewport so Leaflet (~45 kB) and the
// satellite tiles never slow the first paint. `isolate` keeps Leaflet's z-indexes under the header.
import Icon from './Icon.astro';
import { site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/utils';
interface Props { lang: Lang; class?: string; zoom?: number }
const { lang, class: cls = '', zoom = 16 } = Astro.props;
const t = useTranslations(lang);
---
<div class:list={['relative isolate overflow-hidden rounded-[var(--radius-card)] bg-cream-200', cls]}>
  <div data-map class="absolute inset-0" role="region" aria-label={t('map.label')}
    data-lat={site.geo.lat} data-lng={site.geo.lng} data-zoom={zoom} data-name={site.name}
    data-satellite={t('map.satellite')} data-streets={t('map.streets')} data-layers={t('map.layers')}
    data-zoom-in={t('map.zoomIn')} data-zoom-out={t('map.zoomOut')} data-imagery={t('map.imagery')} data-contributors={t('map.contributors')}>
    <div class="grid h-full place-items-center text-pine-800/40"><Icon name="pin" size={40} /></div>
  </div>
  <a href={site.mapsUrl} target="_blank" rel="noopener" class="btn-light absolute right-4 top-4 z-[500] h-10 px-4 text-sm shadow-lg shadow-pine-950/20">
    <Icon name="external" size={15} /> {t('map.open')}
  </a>
</div>

<script>
  import leafletCss from 'leaflet/dist/leaflet.css?url';

  // Leaflet's stylesheet is added only when a map initialises, so it never blocks the first paint.
  function loadCss() {
    if (document.querySelector('link[data-leaflet]')) return;
    const link = Object.assign(document.createElement('link'), { rel: 'stylesheet', href: leafletCss });
    link.dataset.leaflet = '';
    document.head.append(link);
  }

  async function init(el: HTMLElement) {
    loadCss();
    const { default: L } = await import('leaflet');
    el.replaceChildren();
    const { lat, lng, zoom, name, satellite: satLabel, streets: streetLabel, layers: layersLabel, zoomIn, zoomOut, imagery, contributors } = el.dataset;
    // On touch screens one-finger dragging would swallow the page scroll, so the map pans only after a
    // tap on it (and stops again when the visitor touches anything else). Pinch-zoom always works.
    const coarse = matchMedia('(pointer: coarse)').matches;
    const map = L.map(el, { scrollWheelZoom: false, zoomControl: false, dragging: !coarse, attributionControl: false }).setView([+lat!, +lng!], +zoom!);
    L.control.attribution({ prefix: '<a href="https://leafletjs.com">Leaflet</a>' }).addTo(map);
    if (coarse) {
      el.addEventListener('click', () => map.dragging.enable());
      document.addEventListener('touchstart', (e) => { if (!el.contains(e.target as Node)) map.dragging.disable(); }, { passive: true });
    }
    // Controls go where the floating address card is not: bottom right on desktop, top left on phones.
    const corner = matchMedia('(min-width: 1024px)').matches ? 'bottomright' : 'topleft';
    L.control.zoom({ position: corner, zoomInTitle: zoomIn, zoomOutTitle: zoomOut }).addTo(map);
    // Key-free tiles: satellite shows the course layout; the street map is one tap away.
    const satellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
      maxZoom: 18, attribution: `${imagery} &copy; <a href="https://www.esri.com/">Esri</a>, Maxar, Earthstar Geographics`,
    });
    const streets = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19, attribution: `&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> ${contributors}`,
    });
    satellite.addTo(map);
    const layers = L.control.layers({ [satLabel!]: satellite, [streetLabel!]: streets }, {}, { position: corner }).addTo(map);
    // Leaflet's own tooltip for this control is English-only
    const toggle = layers.getContainer()?.querySelector<HTMLElement>('.leaflet-control-layers-toggle');
    if (toggle) { toggle.title = layersLabel!; toggle.setAttribute('aria-label', layersLabel!); }
    const icon = L.divIcon({
      className: '',
      html: '<div style="width:44px;height:44px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);background:#123326;border:3px solid #fbf8f1;box-shadow:0 8px 20px -6px rgba(0,0,0,.5);display:grid;place-items:center"><div style="width:14px;height:14px;border-radius:50%;background:#d9a23a"></div></div>',
      iconSize: [44, 44], iconAnchor: [22, 44], popupAnchor: [0, -44],
    });
    L.marker([+lat!, +lng!], { icon, title: name }).addTo(map);
  }

  const maps = document.querySelectorAll<HTMLElement>('[data-map]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { io.unobserve(e.target); init(e.target as HTMLElement); }
    }, { rootMargin: '400px 0px' });
    maps.forEach((m) => io.observe(m));
  } else maps.forEach(init);
</script>
