---
// Opening of every inner page: a dark band with the headline, and a photo that runs
// from the band down onto the page below.
import Icon from './Icon.astro';
interface Cta { href: string; label: string; icon?: string; book?: boolean; external?: boolean; lang?: string }
interface Props { eyebrow: string; title: string; sub?: string; image?: string; srcset?: string; alt?: string; position?: string; cta1?: Cta; cta2?: Cta }
const { eyebrow, title, sub, image, srcset, alt = '', position = 'center', cta1, cta2 } = Astro.props;
const linkAttrs = (c: Cta) => ({ href: c.href, 'data-book': c.book ? '' : undefined, target: c.external ? '_blank' : undefined, rel: c.external ? 'noopener' : undefined, lang: c.lang, hreflang: c.lang });
---
<section class="on-dark relative isolate">
  <div class:list={['absolute inset-x-0 top-0 -z-10 overflow-hidden bg-pine-950', image ? 'bottom-24 lg:bottom-28' : 'bottom-0']}>
    <div class="absolute -right-40 -top-40 h-[36rem] w-[36rem] rounded-full bg-ochre-500/10 blur-3xl"></div>
  </div>
  <div class:list={['container-x grid gap-10 pt-32 sm:pt-36 lg:grid-cols-12 lg:items-end lg:gap-14 lg:pt-44', !image && 'pb-16 sm:pb-20']}>
    <div class:list={['text-cream-50 lg:col-span-7', image && 'lg:pb-40']}>
      <p class="eyebrow rise">{eyebrow}</p>
      <h1 class="h-display rise mt-5" style="--i:1">{title}</h1>
      {sub && <p class="lede rise mt-6 max-w-xl" style="--i:2">{sub}</p>}
      {(cta1 || cta2) && (
        <div class="rise mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap" style="--i:3">
          {cta1 && <a {...linkAttrs(cta1)} class="btn-primary">{cta1.icon && <Icon name={cta1.icon} size={17} />}{cta1.label}</a>}
          {cta2 && <a {...linkAttrs(cta2)} class="btn-glass">{cta2.icon && <Icon name={cta2.icon} size={17} />}{cta2.label}</a>}
        </div>
      )}
      <slot />
    </div>
    {image && (
      <div class="lg:col-span-5">
        <div class="frame aspect-[5/4] w-full bg-pine-900 shadow-2xl shadow-pine-950/30 sm:aspect-[16/10] lg:aspect-[4/5] lg:max-h-[38rem]">
          <img src={image} srcset={srcset} sizes={srcset ? '(min-width: 1024px) 40vw, 100vw' : undefined} alt={alt} class="img-cover hero-photo" style={`object-position:${position}`} fetchpriority="high" decoding="async" />
        </div>
      </div>
    )}
  </div>
</section>
