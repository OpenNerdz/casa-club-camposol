---
import SectionHeading from './SectionHeading.astro';
interface Props { eyebrow?: string; title: string; intro?: string; align?: 'left' | 'center'; class?: string; id?: string }
const { eyebrow, title, intro, align = 'left', class: cls = '', id } = Astro.props;
---
<section id={id} class:list={['py-20 sm:py-28', cls]}>
  <div class="container-x">
    <SectionHeading eyebrow={eyebrow} title={title} intro={intro} align={align} />
    <slot />
  </div>
</section>
