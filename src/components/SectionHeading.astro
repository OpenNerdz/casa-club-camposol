---
// Eyebrow + headline + intro, the opening of most sections. Titles accept *emphasis*.
import { em } from '../i18n/utils';
interface Props { eyebrow?: string; title: string; intro?: string; align?: 'left' | 'center'; level?: 'h1' | 'h2'; size?: 'display' | 'section'; class?: string }
const { eyebrow, title, intro, align = 'left', level = 'h2', size = 'section', class: cls = '' } = Astro.props;
const Tag = level;
---
<div class:list={['reveal max-w-3xl', align === 'center' && 'mx-auto text-center', cls]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag class:list={['mt-5', size === 'display' ? 'h-display' : 'h-section']} set:html={em(title)} />
  {intro && <p class:list={['lede mt-6 max-w-2xl', align === 'center' && 'mx-auto']}>{intro}</p>}
</div>
