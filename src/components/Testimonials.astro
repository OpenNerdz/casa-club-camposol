---
// One review given more room, the others alongside. Quotes are from public reviews (see STAFF-REVIEW.md).
interface Props { items: readonly { quote: string; who: string }[] }
const [first, ...rest] = Astro.props.items;
---
<div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-16">
  <figure class="reveal lg:col-span-7">
    <blockquote class="text-[clamp(1.4rem,1.15rem+0.9vw,2rem)] font-semibold leading-snug tracking-[-0.02em] text-pine-950">“{first.quote}”</blockquote>
    <figcaption class="mt-5 text-sm font-semibold text-ink-600">{first.who}</figcaption>
  </figure>
  <div class="grid content-start gap-8 lg:col-span-5">
    {rest.map((r) => (
      <figure class="reveal border-t border-ink-950/12 pt-6">
        <blockquote class="text-lg leading-relaxed text-ink-800">“{r.quote}”</blockquote>
        <figcaption class="mt-3 text-sm font-semibold text-ink-600">{r.who}</figcaption>
      </figure>
    ))}
  </div>
</div>
