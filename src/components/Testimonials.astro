---
// Review cards: the first one set apart in pine. A sideways row on phones, three columns on desktop.
// No scroll-reveal here: cards sitting off to the side in the row would stay hidden.
// Quotes are from public reviews (see STAFF-REVIEW.md).
interface Props { items: readonly { quote: string; who: string }[] }
const { items } = Astro.props;
---
<ul class="snap-row mt-12 md:mx-0 md:grid md:grid-cols-3 md:gap-5 md:overflow-visible md:px-0 md:pb-0">
  {items.map((r, i) => (
    <li class:list={['flex w-[82%] flex-col rounded-[var(--radius-card)] p-7 sm:w-[55%] md:w-auto sm:p-8',
      i === 0 ? 'bg-pine-900 text-cream-50' : 'border border-ink-950/8 bg-white text-ink-950']}>
      <svg viewBox="0 0 32 24" width="34" height="26" aria-hidden="true" class:list={[i === 0 ? 'text-ochre-300' : 'text-clay-500']}><path fill="currentColor" d="M0 24V14C0 6 4.5 1.3 12 0l1.4 3.6C9.3 5 7.4 7.6 7.2 11H13v13zm19 0V14c0-8 4.5-12.7 12-14l1 3.6c-4 1.4-6 4-6.2 7.4H32v13z"/></svg>
      <blockquote class:list={['mt-5 flex-1 text-lg font-medium leading-relaxed', i === 0 && 'sm:text-xl']}>{r.quote}</blockquote>
      <p class:list={['mt-6 border-t pt-4 text-sm font-semibold', i === 0 ? 'border-cream-50/15 text-cream-50/70' : 'border-ink-950/10 text-ink-600']}>{r.who}</p>
    </li>
  ))}
</ul>
