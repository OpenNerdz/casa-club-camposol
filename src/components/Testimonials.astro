---
// One review given room to breathe, the others alongside. Quotes are from public reviews (see STAFF-REVIEW.md).
interface Props { items: readonly { quote: string; who: string }[] }
const [first, ...rest] = Astro.props.items;
---
<div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-16">
  <figure class="reveal lg:col-span-7">
    <span class="display block h-14 text-[7rem] leading-none text-clay-500" aria-hidden="true">“</span>
    <blockquote class="display text-[clamp(1.9rem,1.4rem+1.6vw,3rem)] leading-[1.1] text-pine-950">{first.quote}</blockquote>
    <figcaption class="mt-6 text-sm font-semibold uppercase tracking-[0.14em] text-ink-600">{first.who}</figcaption>
  </figure>
  <div class="grid content-start gap-10 lg:col-span-5">
    {rest.map((r) => (
      <figure class="reveal border-t border-ink-950/12 pt-6">
        <blockquote class="text-lg leading-relaxed text-ink-800">“{r.quote}”</blockquote>
        <figcaption class="mt-3 text-sm font-semibold uppercase tracking-[0.14em] text-ink-600">{r.who}</figcaption>
      </figure>
    ))}
  </div>
</div>
