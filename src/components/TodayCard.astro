---
// "Today at Casa Club" on the home hero. The browser picks today's line-up in Spanish time
// (Base.astro): a dated highlight from events.ts if there is one, otherwise the regular programme,
// with a "next up" line on quiet days. Without JS (or before it runs) the generic line shows instead.
import Icon from './Icon.astro';
import { programme, dayNames, type ProgrammeDay, type ProgrammeItem } from '../data/programme';
import { events } from '../content/events';
import { useTranslations, localePath, type Lang } from '../i18n/utils';
import { madridDate } from '../scripts/madrid';
interface Props { lang: Lang; class?: string; style?: string }
const { lang, class: cls = '', style } = Astro.props;
const t = useTranslations(lang);
const names = dayNames[lang];
// Regular events: not the quiet "menú del día" line and not the "selected Saturdays" kind
const regular = (d: ProgrammeDay) => d.items.filter((it) => !it.minor && !it.occasional);
// On a quiet day: the next day with a regular event
const nextUp = (day: number): { day: number; item: ProgrammeItem } | undefined => {
  for (let k = 1; k <= 7; k++) {
    const d = programme.find((x) => x.day === ((day - 1 + k) % 7) + 1);
    if (d && regular(d).length) return { day: d.day, item: regular(d)[0] };
  }
  return undefined;
};
// Dated highlights still to come (the browser shows the one matching today's date)
const today = madridDate();
type Dated = { date?: string; time?: string; title: string; tag: string };
const dated: readonly Dated[] = (events[lang].upcoming.items as readonly Dated[]).filter((e) => e.date && e.date >= today);
const accent = 'font-semibold text-ochre-300';
---
<div class:list={['glass rounded-[1.5rem] p-5 text-cream-50 sm:p-6', cls]} style={style}>
  <p class="flex items-center gap-2 text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-ochre-300">
    <span class="h-2 w-2 rounded-full bg-ochre-300" aria-hidden="true"></span>{t('today.label')}
  </p>
  <p data-today-for="0" class="mt-3 text-lg font-bold">{t('today.fallback')}</p>
  {programme.map((d) => { const main = regular(d); const next = main.length ? undefined : nextUp(d.day); return (
    <div data-today-for={d.day} hidden>
      <p class="mt-3 text-2xl font-extrabold tracking-tight">{names.long[d.day - 1]}</p>
      <div data-regular>
        <ul class="mt-2 space-y-1 text-[0.9375rem] text-cream-50/85">
          {(main.length ? main : d.items).map((it) => (
            <li class="flex flex-wrap justify-between gap-x-4"><span>{it.title[lang]}</span>{(it.time || it.note) && <span class={accent}>{it.time ?? it.note?.[lang]}</span>}</li>
          ))}
        </ul>
        {next && <p class="mt-2 text-sm text-cream-50/70">{t('today.next')}: <span class="text-cream-50/90">{names.long[next.day - 1]} · {next.item.title[lang]}{next.item.time && ` ${next.item.time}`}</span></p>}
      </div>
    </div>
  ); })}
  {dated.map((e) => (
    <ul data-today-date={e.date} hidden class="mt-2 space-y-1 text-[0.9375rem] text-cream-50/85">
      <li class="flex flex-wrap justify-between gap-x-4"><span>{e.title}</span><span class={accent}>{e.time ?? e.tag}</span></li>
    </ul>
  ))}
  <p class="mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t border-cream-50/15 pt-3 text-sm text-cream-50/70">
    <span class="inline-flex items-center gap-2"><Icon name="clock" size={15} /> {t('today.hours')}</span>
    <a href={localePath(lang, '/events/')} class="inline-flex items-center gap-1 font-semibold text-cream-50/90 hover:text-ochre-300">{t('today.link')} <Icon name="arrow" size={14} /></a>
  </p>
</div>
