---
// "Today at Casa Club" on the home hero: today's line-up, chosen in the browser in
// Spanish time. Without JS (or before it runs) the generic line shows instead.
import Icon from './Icon.astro';
import { programme, dayNames } from '../data/programme';
import { useTranslations, type Lang } from '../i18n/utils';
interface Props { lang: Lang; class?: string; style?: string }
const { lang, class: cls = '', style } = Astro.props;
const t = useTranslations(lang);
---
<div class:list={['glass rounded-[1.5rem] p-5 text-cream-50 sm:p-6', cls]} style={style}>
  <p class="flex items-center gap-2 text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-ochre-300">
    <span class="h-2 w-2 rounded-full bg-ochre-300" aria-hidden="true"></span>{t('today.label')}
  </p>
  <p data-today-for="0" class="mt-3 text-lg font-bold">{t('today.fallback')}</p>
  {programme.map((d) => (
    <div data-today-for={d.day} hidden>
      <p class="mt-3 text-2xl font-extrabold tracking-tight">{dayNames[lang].long[d.day - 1]}</p>
      <ul class="mt-2 space-y-1 text-[0.9375rem] text-cream-50/85">
        {d.items.filter((it) => !it.minor || d.items.every((x) => x.minor)).map((it) => (
          <li class="flex justify-between gap-4"><span>{it.title[lang]}</span>{(it.time || it.note) && <span class="shrink-0 font-semibold text-ochre-300">{it.time ?? it.note?.[lang]}</span>}</li>
        ))}
      </ul>
    </div>
  ))}
  <p class="mt-4 flex items-center gap-2 border-t border-cream-50/15 pt-3 text-sm text-cream-50/70"><Icon name="clock" size={15} /> {t('today.hours')}</p>
</div>
