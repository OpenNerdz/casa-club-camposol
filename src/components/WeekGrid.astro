---
interface Props { days: readonly { day: string; items: readonly string[] }[]; note?: string }
const { days, note } = Astro.props;
---
<div class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-7">
  {days.map((d, i) => (
    <div class:list={['reveal rounded-xl2 p-5 ring-1', i === 6 ? 'bg-sol-100 ring-sol-300/60' : i === 4 ? 'bg-green-50 ring-green-100' : 'bg-white ring-ink-900/5']} style={`transition-delay:${i * 60}ms`}>
      <p class="font-display text-2xl text-green-950">{d.day}</p>
      <ul class="mt-3 space-y-2 text-sm leading-snug text-ink-700">
        {d.items.map((it) => <li class="flex gap-2"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-sol-500"></span><span>{it}</span></li>)}
      </ul>
    </div>
  ))}
</div>
{note && <p class="mt-6 text-sm text-ink-500">{note}</p>}
