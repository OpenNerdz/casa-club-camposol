---
// Fonts are self-hosted: no third-party requests, no Google Fonts IP logging (GDPR).
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import sansFont from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookDialog from '../components/BookDialog.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../data/site';
import { getLangFromUrl, switchLang, useTranslations, withBase, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { title, description, image = withBase('/images/og-default.jpg'), jsonLd, noindex = false } = Astro.props;
// Staging builds (e.g. GitHub Pages) set PUBLIC_NOINDEX=1 so search engines ignore them.
const hideFromSearch = noindex || import.meta.env.PUBLIC_NOINDEX === '1';
const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const altEn = new URL(switchLang(Astro.url, 'en'), Astro.site);
const altEs = new URL(switchLang(Astro.url, 'es'), Astro.site);
const fullTitle = title.includes(site.name) ? title : `${title} · ${site.name}`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang={lang === 'en' ? 'en-GB' : 'es-ES'} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
    {hideFromSearch && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#fbf8f1" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-pine-950 focus:px-5 focus:py-2.5 focus:text-cream-50">{t('nav.skip')}</a>
    <Header lang={lang} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <MobileBar lang={lang} />
    <BookDialog lang={lang} />
    <script>
      import { madridDate, madridWeekday } from '../scripts/madrid';

      // Reveal on scroll (content is visible without JS; see .no-js in global.css)
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-visible'));

      // "Today": mark today's programme row and show today's line-up, in Spanish time.
      const day = String(madridWeekday());
      document.querySelectorAll('[data-day]').forEach((el) => el.toggleAttribute('data-today', (el as HTMLElement).dataset.day === day));
      document.querySelectorAll<HTMLElement>('[data-today-for]').forEach((el) => { el.hidden = el.dataset.todayFor !== day; });

      // Dated highlights disappear the day after they happen, even before the next rebuild.
      const today = madridDate();
      document.querySelectorAll<HTMLElement>('[data-until]').forEach((el) => { if (el.dataset.until! < today) el.remove(); });
    </script>
  </body>
</html>
