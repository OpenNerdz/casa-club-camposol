---
// The font is self-hosted: no third-party requests, no Google Fonts IP logging (GDPR).
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '../styles/global.css';
import sansFont from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookDialog from '../components/BookDialog.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../data/site';
import { getLangFromUrl, switchLang, useTranslations, withBase, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  /** 'dark' when the page opens on a dark hero, so the header starts out white. */
  tone?: 'dark' | 'light';
}
const { title, description, image = withBase('/images/og-default.jpg'), jsonLd, noindex = false, tone = 'dark' } = Astro.props;
// Staging builds (e.g. GitHub Pages) set PUBLIC_NOINDEX=1 so search engines ignore them.
const hideFromSearch = noindex || import.meta.env.PUBLIC_NOINDEX === '1';
const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const altEn = new URL(switchLang(Astro.url, 'en'), Astro.site);
const altEs = new URL(switchLang(Astro.url, 'es'), Astro.site);
const fullTitle = title.includes(site.name) ? title : `${title} · ${site.name}`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang={lang === 'en' ? 'en-GB' : 'es-ES'} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="en" href={altEn} />
      <link rel="alternate" hreflang="es" href={altEs} />
      <link rel="alternate" hreflang="x-default" href={altEn} />
    </>}
    {hideFromSearch && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#0c241b" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'es_ES'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'es_ES' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.remove('no-js');setTimeout(function(){if(!document.documentElement.hasAttribute('data-ready'))document.documentElement.classList.add('reveal-off')},3000);</script>
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" data-skip class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-pine-950 focus:px-5 focus:py-2.5 focus:text-cream-50">{t('nav.skip')}</a>
    <Header lang={lang} tone={tone} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <MobileBar lang={lang} />
    <BookDialog lang={lang} />
    <script>
      import { madridDate, madridWeekday } from '../scripts/madrid';
      // Tells the inline watchdog in <head> that this script has run (otherwise it un-hides every .reveal)
      document.documentElement.setAttribute('data-ready', '');

      // Reveal on scroll (content is visible without JS; see .no-js in global.css)
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-visible'));

      // "Today": mark today's programme row and show today's line-up, in Spanish time. Dated highlights
      // disappear the day after they happen, even before the next rebuild. Re-run whenever the visitor
      // comes back to a tab left open across midnight.
      function refresh() {
        const day = String(madridWeekday());
        document.querySelectorAll('[data-day]').forEach((el) => el.toggleAttribute('data-today', (el as HTMLElement).dataset.day === day));
        document.querySelectorAll<HTMLElement>('[data-today-for]').forEach((el) => { el.hidden = el.dataset.todayFor !== day; });
        const today = madridDate();
        document.querySelectorAll<HTMLElement>('[data-until]').forEach((el) => { if (el.dataset.until! < today) el.remove(); });
        // If that empties a list of highlights, show its "nothing announced yet" message instead.
        document.querySelectorAll<HTMLElement>('[data-highlights]').forEach((box) => {
          const list = box.querySelector('ol');
          if (list && !list.children.length) { list.remove(); box.querySelector<HTMLElement>('[data-empty]')!.hidden = false; }
        });
      }
      refresh();
      document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') refresh(); });
      window.addEventListener('pageshow', (e) => { if (e.persisted) refresh(); });
      // On phones the week is a sideways row: open it on today's card.
      document.querySelectorAll<HTMLElement>('[data-week]').forEach((row) => {
        const card = row.querySelector<HTMLElement>('[data-today]');
        if (card && row.scrollWidth > row.clientWidth) row.scrollLeft = card.offsetLeft - parseFloat(getComputedStyle(row).paddingLeft);
      });
      // Sideways rows are keyboard-scrollable only while they actually overflow (desktop shows them as a grid)
      const rows = document.querySelectorAll<HTMLElement>('[data-scroll-row]');
      const setRowTabs = () => rows.forEach((row) => { if (row.scrollWidth > row.clientWidth) row.setAttribute('tabindex', '0'); else row.removeAttribute('tabindex'); });
      setRowTabs();
      let raf = 0;
      window.addEventListener('resize', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(setRowTabs); });
    </script>
  </body>
</html>
