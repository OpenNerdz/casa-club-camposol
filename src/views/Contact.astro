---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import HoursList from '../components/HoursList.astro';
import MapLeaflet from '../components/MapLeaflet.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../content/contact';
import { img, srcset } from '../data/images';
import { site, whatsappBookingHref } from '../data/site';
import { useTranslations, type Lang } from '../i18n/utils';
import { businessJsonLd } from '../data/jsonld';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = contact[lang];
const t = useTranslations(lang);
// Long email addresses may only wrap after the "@" or before the domain ending, never mid-word.
const breakable = (email: string) => email.replace('@', '@<wbr>').replace(/\.(?=[^.]+$)/, '<wbr>.');
const groups = [
  { title: c.cards.club, sub: c.cards.clubSub, links: [
    { href: site.phoneHref, icon: 'phone', label: site.phoneDisplay },
    { href: whatsappBookingHref(lang), icon: 'whatsapp', label: 'WhatsApp', external: true },
    { href: `mailto:${site.email}`, icon: 'mail', label: site.email, html: breakable(site.email) },
  ] },
  { title: c.cards.golf, sub: c.cards.golfSub, links: [
    { href: site.golfPhoneHref, icon: 'phone', label: site.golfPhoneDisplay },
    { href: site.golfLandlineHref, icon: 'phone', label: site.golfLandlineDisplay },
    { href: `mailto:${site.golfEmail}`, icon: 'mail', label: site.golfEmail, html: breakable(site.golfEmail) },
    { href: site.teeTimeUrl, icon: 'calendar', label: t('cta.teeTimes'), external: true },
  ] },
];
---
<Base title={c.meta.title} description={c.meta.description} image={img.ogContact} jsonLd={businessJsonLd(lang)}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} sub={c.hero.sub} image={img.exterior} srcset={srcset.exterior} alt={c.alt} position="78% center" />

  <!-- Ways to get in touch -->
  <section class="container-x pt-12 sm:pt-16">
    <div class="grid gap-4 md:grid-cols-2">
      {groups.map((g, i) => (
        <div class:list={['reveal rounded-[var(--radius-card)] p-6 sm:p-9', i === 0 ? 'bg-pine-900 text-cream-50' : 'border border-ink-950/8 bg-white text-pine-950']}>
          <h2 class="text-2xl font-extrabold tracking-tight">{g.title}</h2>
          <p class:list={['mt-1 text-[0.9375rem]', i === 0 ? 'text-cream-50/70' : 'text-ink-600']}>{g.sub}</p>
          <ul class="mt-6 grid gap-2.5">
            {g.links.map((l) => (
              <li><a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}
                class:list={['group flex min-h-14 items-center gap-4 rounded-2xl px-4 py-3 font-semibold transition-colors', i === 0 ? 'bg-cream-50/8 hover:bg-cream-50/15' : 'bg-cream-100 hover:bg-cream-200']}>
                <span class:list={['grid h-9 w-9 shrink-0 place-items-center rounded-full', i === 0 ? 'bg-ochre-300 text-pine-950' : 'bg-pine-900 text-cream-50']}><Icon name={l.icon} size={17} /></span>
                {'html' in l ? <span class="min-w-0 flex-1 text-[0.9375rem]" set:html={l.html} /> : <span class="min-w-0 flex-1">{l.label}</span>}
                <Icon name="arrow" size={16} class="hidden shrink-0 opacity-50 transition group-hover:translate-x-0.5 group-hover:opacity-100 sm:block" /></a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Find us -->
  <section class="container-x section-y">
    <div class="grid gap-4 lg:grid-cols-12">
      <MapLeaflet lang={lang} class="min-h-[22rem] lg:col-span-7 lg:min-h-[38rem]" />
      <div class="rounded-[var(--radius-card)] border border-ink-950/8 bg-white p-7 sm:p-9 lg:col-span-5">
        <h2 class="text-3xl text-pine-950">{c.findTitle}</h2>
        <address class="mt-4 not-italic leading-relaxed text-ink-800">{site.address.lines.map((l) => <span class="block">{l}</span>)}<span class="block">{site.address.countryName[lang]}</span></address>
        <a href={site.directionsUrl} target="_blank" rel="noopener" class="btn-dark mt-6"><Icon name="navigation" size={16} /> {t('cta.directions')}</a>
        <h3 class="mt-10 text-xl text-pine-950">{c.directions.title}</h3>
        <ol class="mt-4 space-y-4 text-[0.9375rem] text-ink-800">
          {c.directions.steps.map((s, i) => <li class="flex gap-4"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-cream-200 text-xs font-bold text-pine-900">{i + 1}</span><span>{s}</span></li>)}
        </ol>
        <h3 class="mt-10 text-xl text-pine-950">{c.hoursTitle}</h3>
        <HoursList lang={lang} class="mt-2" />
        <p class="mt-3 text-xs text-ink-600">{t('footer.hoursNote')}</p>
      </div>
    </div>
  </section>

  <!-- Enquiry form -->
  <section id="enquiry" class="section-y bg-cream-100">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow={t('cta.enquire')} title={c.formTitle} intro={c.formText} />
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={whatsappBookingHref(lang)} class="btn-primary" target="_blank" rel="noopener"><Icon name="whatsapp" size={16} /> WhatsApp</a>
          <a href={site.phoneHref} class="btn-line"><Icon name="phone" size={16} /> {t('cta.call')}</a>
        </div>
      </div>
      <div class="lg:col-span-7"><ContactForm lang={lang} /></div>
    </div>
  </section>
</Base>
