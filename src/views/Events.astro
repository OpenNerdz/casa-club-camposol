---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Timetable from '../components/Timetable.astro';
import CheckList from '../components/CheckList.astro';
import Icon from '../components/Icon.astro';
import { events } from '../content/events';
import { img } from '../data/images';
import { site, whatsappEventHref } from '../data/site';
import { localePath, useTranslations, type Lang } from '../i18n/utils';
import { madridDate } from '../scripts/madrid';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = events[lang];
const t = useTranslations(lang);
const locale = lang === 'es' ? 'es-ES' : 'en-GB';
// One-off events carry a `date` (and maybe a `time`); recurring ones a free-text `when`. A dated
// event with a `when` shows that label (e.g. 'Halloween') and still drops off after its date.
type Highlight = { date?: string; time?: string; when?: string; title: string; text: string; tag: string; book?: string };
// Phone numbers in event text become WhatsApp links (the text says to book by WhatsApp)
const linkPhones = (s: string) => s.replace(/\+34(?:[\s\u00a0]\d{2,3}){4}/g, (m) => `<a href="https://wa.me/${m.replace(/\D/g, '')}" target="_blank" rel="noopener" class="font-semibold text-pine-800 underline decoration-pine-800/30 underline-offset-2 hover:text-clay-700">${m}</a>`);
const items: readonly Highlight[] = c.upcoming.items;
// Past one-off events are dropped at build time, and in the browser by Base.astro's script.
const buildDay = madridDate();
const highlights = items
  .filter((e) => !e.date || e.date >= buildDay)
  .map((e) => {
    if (!e.date || e.when) return { ...e, until: e.date, big: undefined, small: e.when, weekday: undefined };
    const d = new Date(`${e.date}T12:00:00`);
    const weekday = d.toLocaleDateString(locale, { weekday: 'long' });
    return {
      ...e, until: e.date,
      big: d.getDate(),
      small: d.toLocaleDateString(locale, { month: 'short', year: 'numeric' }),
      weekday: e.time ? `${weekday}${lang === 'es' ? ',' : ''} ${e.time}` : weekday,
    };
  });
---
<Base title={c.meta.title} description={c.meta.description} image={img.ogEvents}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} sub={c.hero.sub} image={img.heroEvents} alt={c.alts.hero}
    cta1={{ href: `${localePath(lang, '/contact/')}?type=table#enquiry`, label: t('cta.book'), book: true }}
    cta2={{ href: site.social.facebook, label: c.follow.cta, icon: 'facebook', external: true }} />

  <Section id="week" eyebrow={c.week.eyebrow} title={c.week.title} intro={c.week.intro}>
    <Timetable lang={lang} note={c.week.note} />
  </Section>

  <Section eyebrow={c.upcoming.eyebrow} title={c.upcoming.title} class="bg-cream-100">
    <!-- When every dated event has passed (at build time or later, see Base.astro), the message shows instead -->
    <div data-highlights>
    {highlights.length > 0 && <ol class="mt-12 grid gap-4 md:grid-cols-2">
      {highlights.map((e, i) => (
        <li data-until={e.until} class="reveal flex flex-col gap-3 rounded-[var(--radius-card)] border border-ink-950/8 bg-white p-4 sm:flex-row sm:gap-5 sm:p-5" style={`transition-delay:${(i % 2) * 80}ms`}>
          <!-- Date: a small chip above the text on phones, a square block beside it on larger screens -->
          <div class:list={['flex shrink-0 items-center gap-2.5 self-start rounded-2xl px-4 py-2.5 sm:w-28 sm:flex-col sm:justify-center sm:gap-0 sm:self-stretch sm:px-2 sm:py-5 sm:text-center', e.big ? 'bg-clay-600 text-white' : 'bg-pine-900 text-cream-50']}>
            {e.big ? (
              <>
                <span class="text-2xl font-extrabold leading-none tracking-[-0.04em] sm:text-[2.75rem]">{e.big}</span>
                <span class="text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-white sm:mt-1.5">{e.small}</span>
              </>
            ) : (
              <>
                <Icon name="calendar" size={20} class="text-ochre-300" />
                <span class="text-sm font-semibold leading-tight sm:mt-3">{e.small}</span>
              </>
            )}
          </div>
          <div class="sm:py-2 sm:pr-2">
            <p class="text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-clay-700">{e.tag}{e.weekday && <span class="text-ink-600"> · {e.weekday}</span>}</p>
            <h3 class="mt-2 text-xl text-pine-950">{e.title}</h3>
            <p class="mt-2 text-ink-600" set:html={linkPhones(e.text)} />
            <a href={e.book ?? whatsappEventHref(lang, e.title)} target="_blank" rel="noopener" class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-full border border-ink-950/15 px-4 text-sm font-semibold text-pine-950 transition-colors hover:border-pine-900 hover:bg-pine-900 hover:text-cream-50"><Icon name="whatsapp" size={15} /> {c.upcoming.book}</a>
          </div>
        </li>
      ))}
    </ol>}
    <p data-empty hidden={highlights.length > 0} class="mt-10 max-w-2xl text-lg text-ink-600">
      {c.upcoming.empty} <a href={site.social.facebook} target="_blank" rel="noopener" class="link-arrow">Facebook <Icon name="external" size={15} /></a>
    </p>
    </div>
  </Section>

  <section id="hire" class="container-x section-y grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-20">
    <div class="lg:col-span-7">
      <SectionHeading eyebrow={c.hire.eyebrow} title={c.hire.title} intro={c.hire.text} />
      <CheckList items={c.hire.points} columns={2} class="reveal mt-8" />
      <a href={`${localePath(lang, '/contact/')}?type=event#enquiry`} class="btn-dark mt-10">{c.hire.cta} <Icon name="arrow" size={16} /></a>
    </div>
    <div class="reveal lg:col-span-5">
      <div class="frame aspect-[4/3] bg-cream-200 lg:aspect-[4/5]"><img src={img.functionRoom} alt={c.alts.hire} class="img-cover" loading="lazy" decoding="async" /></div>
    </div>
  </section>

  <section class="container-x pb-16 sm:pb-24 lg:pb-28">
    <div class="on-dark grid gap-10 rounded-[2rem] bg-pine-950 p-8 text-cream-50 sm:p-12 lg:grid-cols-12 lg:items-center lg:p-16">
      <div class="lg:col-span-8">
        <p class="eyebrow">{c.community.eyebrow}</p>
        <h2 class="h-section mt-4">{c.community.title}</h2>
        <p class="lede mt-5 max-w-2xl">{c.community.text}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:col-span-4 lg:flex-col lg:items-stretch">
        <a href={`${localePath(lang, '/contact/')}?type=event#enquiry`} class="btn-light">{c.community.cta} <Icon name="arrow" size={16} /></a>
        <a href={site.social.facebook} target="_blank" rel="noopener" class="btn-glass"><Icon name="facebook" size={16} /> {c.follow.cta}</a>
      </div>
    </div>
  </section>
</Base>
