---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import WeekGrid from '../components/WeekGrid.astro';
import { events } from '../content/events';
import { home } from '../content/home';
import { img } from '../data/images';
import { site } from '../data/site';
import { localePath, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = events[lang];
const week = home[lang].week;
---
<Base title={c.meta.title} description={c.meta.description} header="transparent" image={img.events}>
  <Hero image={img.heroEvents} compact eyebrow={c.hero.eyebrow} title={c.hero.title} sub={c.hero.sub}
    cta1={{ href: site.social.facebook, label: c.follow.cta, icon: 'facebook' }} />

  <Section eyebrow={c.week.eyebrow} title={c.week.title} intro={c.week.intro}>
    <WeekGrid days={week.days} note={week.note} />
  </Section>

  <Section eyebrow={c.upcoming.eyebrow} title={c.upcoming.title} class="bg-sand-100">
    <ol class="mt-12 grid gap-5 md:grid-cols-2">
      {c.upcoming.items.map((e, i) => (
        <li class="card reveal flex gap-5 p-6" style={`transition-delay:${(i % 2) * 90}ms`}>
          <div class="flex w-24 shrink-0 flex-col items-center justify-center rounded-xl bg-green-900 p-3 text-center text-white">
            <Icon name="calendar" size={18} class="text-sol-300" />
            <span class="mt-2 text-xs font-semibold leading-tight">{e.date}</span>
          </div>
          <div>
            <span class="rounded-full bg-sol-100 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-sol-600">{e.tag}</span>
            <h3 class="mt-2 text-xl text-green-950">{e.title}</h3>
            <p class="mt-1.5 text-ink-500">{e.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <section class="py-16 sm:py-24">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal">
        <p class="eyebrow">{c.hire.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-medium leading-tight text-green-950 sm:text-5xl">{c.hire.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-500">{c.hire.text}</p>
        <ul class="mt-7 grid gap-3">{c.hire.points.map((p) => <li class="flex items-start gap-2.5"><Icon name="check" size={18} class="mt-0.5 shrink-0 text-sol-500" /><span>{p}</span></li>)}</ul>
        <a href={localePath(lang, '/contact/')} class="btn-primary mt-9">{c.hire.cta} <Icon name="arrow" size={16} /></a>
      </div>
      <div class="reveal aspect-[4/3] overflow-hidden rounded-xl2 shadow-card"><img src={img.terrace} alt="" class="img-cover" loading="lazy" decoding="async" /></div>
    </div>
  </section>

  <section class="bg-green-950 py-16 text-white sm:py-20">
    <div class="container-x grid items-center gap-10 lg:grid-cols-3">
      <div class="reveal lg:col-span-2">
        <p class="eyebrow text-sol-300">{c.community.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-medium sm:text-4xl">{c.community.title}</h2>
        <p class="mt-4 text-lg text-sand-200/85">{c.community.text}</p>
      </div>
      <div class="reveal flex flex-col gap-3 lg:items-end">
        <a href={localePath(lang, '/contact/')} class="btn-accent">{c.community.cta}</a>
        <a href={site.social.facebook} target="_blank" rel="noopener" class="btn-ghost"><Icon name="facebook" size={16} /> {c.follow.cta}</a>
      </div>
    </div>
  </section>
</Base>
