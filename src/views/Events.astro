---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Timetable from '../components/Timetable.astro';
import CheckList from '../components/CheckList.astro';
import Icon from '../components/Icon.astro';
import { events } from '../content/events';
import { img } from '../data/images';
import { site } from '../data/site';
import { localePath, useTranslations, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = events[lang];
const t = useTranslations(lang);
const locale = lang === 'es' ? 'es-ES' : 'en-GB';
// Past one-off events are dropped at build time, and in the browser by Base.astro's script.
const buildDay = new Date().toISOString().slice(0, 10);
const highlights = c.upcoming.items
  .filter((e) => !('date' in e) || e.date >= buildDay)
  .map((e) => {
    if (!('date' in e)) return { ...e, until: undefined, big: undefined, small: e.when, weekday: undefined };
    const d = new Date(`${e.date}T12:00:00`);
    return {
      ...e, until: e.date,
      big: d.getDate(),
      small: d.toLocaleDateString(locale, { month: 'short', year: 'numeric' }),
      weekday: d.toLocaleDateString(locale, { weekday: 'long' }),
    };
  });
---
<Base title={c.meta.title} description={c.meta.description} image={img.events}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} sub={c.hero.sub} image={img.heroEvents} alt={c.alts.hero}
    cta1={{ href: `${localePath(lang, '/contact/')}?type=table#enquiry`, label: t('cta.book'), book: true }}
    cta2={{ href: site.social.facebook, label: c.follow.cta, icon: 'facebook', external: true }} />

  <Section id="week" eyebrow={c.week.eyebrow} title={c.week.title} intro={c.week.intro}>
    <Timetable lang={lang} note={c.week.note} />
  </Section>

  <Section eyebrow={c.upcoming.eyebrow} title={c.upcoming.title} class="bg-cream-100">
    <ol class="mt-14 grid gap-5 md:grid-cols-2">
      {highlights.map((e, i) => (
        <li data-until={e.until} class="reveal flex overflow-hidden rounded-[1.5rem] border border-ink-950/10 bg-cream-50" style={`transition-delay:${(i % 2) * 80}ms`}>
          <div class="relative flex w-28 shrink-0 flex-col items-center justify-center bg-pine-900 px-3 py-6 text-center text-cream-50 sm:w-32">
            {e.big ? (
              <>
                <span class="text-[2.6rem] font-bold leading-none tracking-[-0.03em]">{e.big}</span>
                <span class="mt-1 text-xs font-semibold uppercase tracking-[0.14em] text-ochre-300">{e.small}</span>
              </>
            ) : (
              <>
                <Icon name="calendar" size={22} class="text-ochre-300" />
                <span class="mt-3 text-sm font-semibold leading-tight">{e.small}</span>
              </>
            )}
          </div>
          <div class="p-6 sm:p-7">
            <p class="text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-clay-700">{e.tag}{e.weekday && <span class="text-ink-400"> · {e.weekday}</span>}</p>
            <h3 class="mt-2 text-xl text-pine-950">{e.title}</h3>
            <p class="mt-2 text-ink-600">{e.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <section id="hire" class="container-x grid gap-14 py-20 sm:py-28 lg:grid-cols-12 lg:items-center lg:gap-20">
    <div class="lg:col-span-7">
      <SectionHeading eyebrow={c.hire.eyebrow} title={c.hire.title} intro={c.hire.text} />
      <CheckList items={c.hire.points} columns={2} class="reveal mt-8" />
      <a href={`${localePath(lang, '/contact/')}?type=event#enquiry`} class="btn-dark mt-10">{c.hire.cta} <Icon name="arrow" size={16} /></a>
    </div>
    <div class="reveal mx-auto w-full max-w-sm lg:col-span-5 lg:max-w-none">
      <div class="frame aspect-[4/5] bg-cream-200"><img src={img.functionRoom} alt={c.alts.hire} class="img-cover" loading="lazy" decoding="async" /></div>
    </div>
  </section>

  <section class="container-x">
    <div class="on-dark grid gap-10 rounded-[2rem] bg-pine-950 p-8 text-cream-50 sm:p-12 lg:grid-cols-12 lg:items-center lg:p-16">
      <div class="lg:col-span-8">
        <p class="eyebrow">{c.community.eyebrow}</p>
        <h2 class="h-section mt-4">{c.community.title}</h2>
        <p class="lede mt-5 max-w-2xl">{c.community.text}</p>
      </div>
      <div class="flex flex-col gap-3 lg:col-span-4 lg:items-end">
        <a href={`${localePath(lang, '/contact/')}?type=event#enquiry`} class="btn-light">{c.community.cta} <Icon name="arrow" size={16} /></a>
        <a href={site.social.facebook} target="_blank" rel="noopener" class="btn-ghost"><Icon name="facebook" size={16} /> {c.follow.cta}</a>
      </div>
    </div>
  </section>
</Base>
