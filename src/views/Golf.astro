---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CheckList from '../components/CheckList.astro';
import Icon from '../components/Icon.astro';
import { golf } from '../content/golf';
import { img } from '../data/images';
import { site } from '../data/site';
import { localePath, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = golf[lang];
const fmt = (n: number) => n.toLocaleString(lang === 'es' ? 'es-ES' : 'en-GB');
// Tee-marker colours for the scorecard swatches
const swatch: Record<string, string> = { White: '#ffffff', Yellow: '#f2c94c', Blue: '#2f6fd6', Red: '#c8102e' };
const stats = [
  { v: site.golf.holes, l: c.statLabels.holes },
  { v: site.golf.par, l: c.statLabels.par },
  { v: site.golf.opened, l: c.statLabels.opened },
];
---
<Base title={c.meta.title} description={c.meta.description} image={img.course}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} sub={c.hero.sub} image={img.golfPortrait} alt={c.alts.hero} position="center 35%"
    cta1={{ href: site.teeTimeUrl, label: c.hero.cta1, icon: 'calendar', external: true }}
    cta2={{ href: site.golfPhoneHref, label: c.hero.cta2, icon: 'phone' }} />

  <!-- The course + scorecard -->
  <section class="container-x section-y grid gap-12 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-7">
      <SectionHeading eyebrow={c.course.eyebrow} title={c.course.title} intro={c.course.text} />
      <dl class="reveal mt-10 grid max-w-xl grid-cols-3 gap-3">
        {stats.map((s) => <div class="rounded-2xl bg-pine-100 p-5"><dt class="text-[2rem] font-extrabold leading-none tracking-[-0.04em] text-pine-900 sm:text-[2.5rem]">{s.v}</dt><dd class="mt-2 text-xs font-bold uppercase tracking-[0.14em] text-pine-700">{s.l}</dd></div>)}
      </dl>
    </div>
    <div class="reveal self-end lg:col-span-5">
      <div class="overflow-hidden rounded-[var(--radius-card)] border border-ink-950/8 bg-white shadow-[0_30px_60px_-40px_rgb(23_32_27/.45)]">
        <h3 class="bg-pine-900 px-6 py-4 text-lg text-cream-50">{c.teesTitle}</h3>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[22rem] text-[0.9375rem]">
            <thead class="text-left text-[0.6875rem] uppercase tracking-[0.14em] text-ink-600">
              <tr class="border-b border-ink-950/10">{c.teeCols.map((h, i) => <th scope="col" class:list={['px-4 py-3 font-semibold', i > 0 && 'text-right']}>{h}</th>)}</tr>
            </thead>
            <tbody class="divide-y divide-ink-950/8 tabular-nums">
              {site.golf.tees.map((tee) => (
                <tr>
                  <th scope="row" class="px-4 py-3.5 text-left font-semibold text-pine-950">
                    <span class="inline-flex items-center gap-2.5"><span class="h-3.5 w-3.5 rounded-full ring-1 ring-ink-950/25" style={`background:${swatch[tee.name]}`}></span>{lang === 'es' ? tee.es : tee.name}</span>
                  </th>
                  <td class="px-4 py-3.5 text-right">{fmt(tee.metres)} m</td>
                  <td class="px-4 py-3.5 text-right">{tee.par}</td>
                  <td class="px-4 py-3.5 text-right">{'cr' in tee ? tee.cr : '–'}</td>
                  <td class="px-4 py-3.5 text-right">{'slope' in tee ? tee.slope : '–'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Facilities -->
  <section class="on-dark section-y relative isolate overflow-hidden bg-pine-950 text-cream-50">
    <img src={img.course2} alt="" class="img-cover absolute inset-0 -z-10 opacity-40" loading="lazy" decoding="async" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-pine-950/80 via-pine-950/85 to-pine-950"></div>
    <div class="container-x">
      <SectionHeading eyebrow={c.facilities.eyebrow} title={c.facilities.title} />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {c.facilities.items.map((f, i) => (
          <li class="glass reveal rounded-[var(--radius-card)] p-7" style={`transition-delay:${(i % 3) * 80}ms`}>
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-ochre-300 text-pine-950"><Icon name={f.icon} size={22} /></span>
            <h3 class="mt-5 text-xl">{f.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-cream-50/75">{f.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Green fees -->
  <Section eyebrow={c.fees.eyebrow} title={c.fees.title} intro={c.fees.text}>
    <div class="mt-12 grid gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {c.fees.rows.map((r, i) => { const f = site.golf.fees.find((x) => x.key === r.key)!; return (
        <div class="reveal flex flex-col rounded-[var(--radius-card)] border border-ink-950/8 bg-white p-7" style={`transition-delay:${i * 80}ms`}>
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-ink-600">{r.label}</p>
          <p class="mt-auto pt-10 text-sm text-ink-600">{c.fees.from}</p>
          <p class="text-5xl font-extrabold tracking-[-0.04em] text-pine-950">{f.eur}<span class="ml-1 text-2xl text-clay-600">€</span></p>
        </div>
      ); })}
      <div class="reveal flex flex-col rounded-[var(--radius-card)] bg-pine-900 p-7 text-cream-50 sm:col-span-3 lg:col-span-1">
        <h3 class="text-xl">{c.booking.title}</h3>
        <p class="mt-2 text-[0.9375rem] text-cream-50/75">{c.booking.text}</p>
        <div class="mt-auto grid gap-2.5 pt-6">
          <a href={site.teeTimeUrl} class="btn-light" target="_blank" rel="noopener"><Icon name="calendar" size={16} /> {c.booking.online}</a>
          <a href={site.golfPhoneHref} class="btn-glass"><Icon name="phone" size={16} /> {site.golfPhoneDisplay}</a>
        </div>
      </div>
    </div>
    <p class="mt-6 text-sm text-ink-600">{c.fees.note}</p>
  </Section>

  <!-- Societies -->
  <section class="section-y bg-cream-100">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-20">
      <div class="reveal frame aspect-[4/3] bg-cream-200 lg:col-span-6"><img src={img.range} alt={c.alts.range} class="img-cover" loading="lazy" decoding="async" /></div>
      <div class="lg:col-span-6">
        <SectionHeading eyebrow={c.societies.eyebrow} title={c.societies.title} intro={c.societies.text} />
        <CheckList items={c.societies.points} class="reveal mt-8" />
        <a href={`${localePath(lang, '/contact/')}?type=golf#enquiry`} class="btn-dark mt-10">{c.societies.cta} <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>
</Base>
