---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import { golf } from '../content/golf';
import { img } from '../data/images';
import { site } from '../data/site';
import { localePath, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = golf[lang];
const fmt = (n: number) => lang === 'es' ? n.toLocaleString('es-ES') : n.toLocaleString('en-GB');
---
<Base title={c.meta.title} description={c.meta.description} header="transparent" image={img.course}>
  <Hero image={img.heroGolf} compact eyebrow={c.hero.eyebrow} title={c.hero.title} sub={c.hero.sub}
    cta1={{ href: site.teeTimeUrl, label: c.hero.cta1, icon: 'calendar' }} cta2={{ href: site.golfPhoneHref, label: c.hero.cta2, icon: 'phone' }} />

  <section class="py-16 sm:py-24">
    <div class="container-x grid items-start gap-12 lg:grid-cols-5">
      <div class="reveal lg:col-span-3">
        <p class="eyebrow">{c.course.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-medium leading-tight text-green-950 sm:text-5xl">{c.course.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-500">{c.course.text}</p>
        <dl class="mt-8 grid grid-cols-3 gap-6">
          <div><dt class="font-display text-4xl text-green-800">{site.golf.holes}</dt><dd class="text-xs font-semibold uppercase tracking-wider text-ink-500">{lang === 'en' ? 'holes' : 'hoyos'}</dd></div>
          <div><dt class="font-display text-4xl text-green-800">{site.golf.par}</dt><dd class="text-xs font-semibold uppercase tracking-wider text-ink-500">par</dd></div>
          <div><dt class="font-display text-4xl text-green-800">{site.golf.opened}</dt><dd class="text-xs font-semibold uppercase tracking-wider text-ink-500">{lang === 'en' ? 'opened' : 'inauguración'}</dd></div>
        </dl>
      </div>
      <div class="card reveal overflow-hidden lg:col-span-2">
        <div class="bg-green-900 px-6 py-4 text-white"><h3 class="font-display text-xl">{c.teesTitle}</h3></div>
        <table class="w-full text-sm">
          <thead class="bg-sand-100 text-left text-xs uppercase tracking-wider text-ink-500"><tr>{c.teeCols.map((h) => <th class="px-4 py-2.5 font-semibold">{h}</th>)}</tr></thead>
          <tbody class="divide-y divide-ink-900/5">
            {site.golf.tees.map((t) => (
              <tr>
                <td class="px-4 py-3 font-semibold text-green-950">{lang === 'es' ? t.es : t.name}</td>
                <td class="px-4 py-3">{fmt(t.metres)} m</td>
                <td class="px-4 py-3">{t.par}</td>
                <td class="px-4 py-3">{'cr' in t ? t.cr : '–'}</td>
                <td class="px-4 py-3">{'slope' in t ? t.slope : '–'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-green-950 py-20 text-white">
    <img src={img.course2} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-30" loading="lazy" decoding="async" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-green-950/80 to-green-950"></div>
    <div class="container-x">
      <div class="reveal max-w-2xl"><p class="eyebrow text-sol-300">{c.facilities.eyebrow}</p><h2 class="mt-3 text-3xl font-medium sm:text-5xl">{c.facilities.title}</h2></div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {c.facilities.items.map((f, i) => (
          <div class="reveal rounded-xl2 bg-white/5 p-7 ring-1 ring-white/10 backdrop-blur-sm" style={`transition-delay:${(i % 3) * 90}ms`}>
            <span class="grid h-11 w-11 place-items-center rounded-full bg-sol-500/20 text-sol-300"><Icon name={f.icon} size={20} /></span>
            <h3 class="mt-5 text-xl">{f.title}</h3>
            <p class="mt-2 text-sand-200/80">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Section eyebrow={c.fees.eyebrow} title={c.fees.title} intro={c.fees.text}>
    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {c.fees.rows.map((r) => { const f = site.golf.fees.find((x) => x.key === r.key)!; return (
        <div class="card reveal p-7 text-center">
          <p class="text-sm font-semibold uppercase tracking-wider text-ink-500">{r.label}</p>
          <p class="mt-3 font-display text-5xl text-green-800"><span class="text-base font-sans font-semibold text-ink-300">{c.fees.from} </span>{f.eur} €</p>
        </div>
      ); })}
    </div>
    <p class="mt-8 text-sm text-ink-500">{c.fees.note}</p>
    <div class="mt-10 card flex flex-col items-start gap-5 p-8 sm:flex-row sm:items-center sm:justify-between">
      <div><h3 class="text-2xl text-green-950">{c.booking.title}</h3><p class="mt-1 text-ink-500">{c.booking.text}</p></div>
      <div class="flex flex-wrap gap-3">
        <a href={site.teeTimeUrl} class="btn-primary" target="_blank" rel="noopener"><Icon name="calendar" size={16} /> {c.booking.online}</a>
        <a href={site.golfPhoneHref} class="btn-outline"><Icon name="phone" size={16} /> {c.booking.phone}: {site.golfPhoneDisplay}</a>
      </div>
    </div>
  </Section>

  <section class="bg-sand-100 py-16 sm:py-24">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal aspect-[4/3] overflow-hidden rounded-xl2 shadow-card"><img src={img.range} alt="" class="img-cover" loading="lazy" decoding="async" /></div>
      <div class="reveal">
        <p class="eyebrow">{c.societies.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-medium leading-tight text-green-950 sm:text-5xl">{c.societies.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-500">{c.societies.text}</p>
        <ul class="mt-7 grid gap-3">{c.societies.points.map((p) => <li class="flex items-start gap-2.5"><Icon name="check" size={18} class="mt-0.5 shrink-0 text-sol-500" /><span>{p}</span></li>)}</ul>
        <a href={localePath(lang, '/contact/')} class="btn-primary mt-9">{c.societies.cta} <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>
</Base>
