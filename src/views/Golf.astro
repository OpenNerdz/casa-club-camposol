---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CheckList from '../components/CheckList.astro';
import Icon from '../components/Icon.astro';
import { golf } from '../content/golf';
import { img } from '../data/images';
import { site } from '../data/site';
import { localePath, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = golf[lang];
const fmt = (n: number) => n.toLocaleString(lang === 'es' ? 'es-ES' : 'en-GB');
// Tee-marker colours for the scorecard swatches
const swatch: Record<string, string> = { White: '#ffffff', Yellow: '#f2c94c', Blue: '#2f6fd6', Red: '#c8102e' };
const stats = [
  { v: site.golf.holes, l: c.statLabels.holes },
  { v: site.golf.par, l: c.statLabels.par },
  { v: site.golf.opened, l: c.statLabels.opened },
];
---
<Base title={c.meta.title} description={c.meta.description} image={img.course}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} sub={c.hero.sub} image={img.golfPortrait} alt={c.alts.hero} position="center 35%"
    cta1={{ href: site.teeTimeUrl, label: c.hero.cta1, icon: 'calendar', external: true }}
    cta2={{ href: site.golfPhoneHref, label: c.hero.cta2, icon: 'phone' }} />

  <!-- The course + scorecard -->
  <section class="container-x grid gap-14 py-20 sm:py-28 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-7">
      <SectionHeading eyebrow={c.course.eyebrow} title={c.course.title} intro={c.course.text} />
      <dl class="reveal mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-ink-950/12 pt-8">
        {stats.map((s) => <div><dt class="text-[2.5rem] font-bold leading-none tracking-[-0.03em] text-pine-900">{s.v}</dt><dd class="mt-2 text-xs font-semibold uppercase tracking-[0.14em] text-ink-600">{s.l}</dd></div>)}
      </dl>
    </div>
    <div class="reveal self-end lg:col-span-5">
      <div class="overflow-hidden rounded-[1.5rem] border border-ink-950/12 bg-cream-50">
        <h3 class="bg-pine-900 px-6 py-4 text-lg text-cream-50">{c.teesTitle}</h3>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[22rem] text-[0.9375rem]">
            <thead class="text-left text-[0.6875rem] uppercase tracking-[0.14em] text-ink-600">
              <tr class="border-b border-ink-950/10">{c.teeCols.map((h, i) => <th scope="col" class:list={['px-4 py-3 font-semibold', i > 0 && 'text-right']}>{h}</th>)}</tr>
            </thead>
            <tbody class="divide-y divide-ink-950/8 tabular-nums">
              {site.golf.tees.map((tee) => (
                <tr>
                  <th scope="row" class="px-4 py-3.5 text-left font-semibold text-pine-950">
                    <span class="inline-flex items-center gap-2.5"><span class="h-3.5 w-3.5 rounded-full ring-1 ring-ink-950/25" style={`background:${swatch[tee.name]}`}></span>{lang === 'es' ? tee.es : tee.name}</span>
                  </th>
                  <td class="px-4 py-3.5 text-right">{fmt(tee.metres)} m</td>
                  <td class="px-4 py-3.5 text-right">{tee.par}</td>
                  <td class="px-4 py-3.5 text-right">{'cr' in tee ? tee.cr : '–'}</td>
                  <td class="px-4 py-3.5 text-right">{'slope' in tee ? tee.slope : '–'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Facilities -->
  <section class="on-dark relative isolate overflow-hidden bg-pine-950 py-20 text-cream-50 sm:py-28">
    <img src={img.course2} alt="" class="img-cover absolute inset-0 -z-10 opacity-20" loading="lazy" decoding="async" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-pine-950/70 to-pine-950"></div>
    <div class="container-x">
      <SectionHeading eyebrow={c.facilities.eyebrow} title={c.facilities.title} />
      <ul class="mt-14 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
        {c.facilities.items.map((f, i) => (
          <li class="reveal border-t border-cream-50/15 py-7" style={`transition-delay:${(i % 3) * 80}ms`}>
            <Icon name={f.icon} size={24} class="text-ochre-300" />
            <h3 class="mt-4 text-xl">{f.title}</h3>
            <p class="mt-3 text-cream-50/70">{f.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Green fees -->
  <Section eyebrow={c.fees.eyebrow} title={c.fees.title} intro={c.fees.text}>
    <div class="mt-14 grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="reveal lg:col-span-7">
        <ul class="border-b border-ink-950/12">
          {c.fees.rows.map((r) => { const f = site.golf.fees.find((x) => x.key === r.key)!; return (
            <li class="flex items-baseline justify-between gap-4 border-t border-ink-950/12 py-5">
              <span class="text-lg font-semibold text-pine-950">{r.label}</span>
              <span class="shrink-0 text-ink-600"><span class="text-sm">{c.fees.from}</span> <span class="text-2xl font-bold tracking-tight text-clay-700">{f.eur} €</span></span>
            </li>
          ); })}
        </ul>
        <p class="mt-6 text-sm text-ink-600">{c.fees.note}</p>
      </div>
      <div class="panel flex flex-col p-8 lg:col-span-5">
        <h3 class="text-2xl text-pine-950">{c.booking.title}</h3>
        <p class="mt-3 text-ink-600">{c.booking.text}</p>
        <div class="mt-auto grid gap-3 pt-8">
          <a href={site.teeTimeUrl} class="btn-dark" target="_blank" rel="noopener"><Icon name="calendar" size={16} /> {c.booking.online}</a>
          <a href={site.golfPhoneHref} class="btn-line"><Icon name="phone" size={16} /> {c.booking.phone}: {site.golfPhoneDisplay}</a>
        </div>
      </div>
    </div>
  </Section>

  <!-- Societies -->
  <section class="bg-cream-100 py-20 sm:py-28">
    <div class="container-x grid gap-14 lg:grid-cols-12 lg:items-center lg:gap-20">
      <div class="reveal frame aspect-[4/3] bg-cream-200 lg:col-span-6"><img src={img.range} alt={c.alts.range} class="img-cover" loading="lazy" decoding="async" /></div>
      <div class="lg:col-span-6">
        <SectionHeading eyebrow={c.societies.eyebrow} title={c.societies.title} intro={c.societies.text} />
        <CheckList items={c.societies.points} class="reveal mt-8" />
        <a href={`${localePath(lang, '/contact/')}?type=golf#enquiry`} class="btn-dark mt-10">{c.societies.cta} <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>
</Base>
