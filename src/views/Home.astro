---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import WeekGrid from '../components/WeekGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import MapLeaflet from '../components/MapLeaflet.astro';
import { home } from '../content/home';
import { img } from '../data/images';
import { site } from '../data/site';
import { localePath, type Lang } from '../i18n/utils';
import { businessJsonLd } from '../data/jsonld';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = home[lang];
---
<Base title={c.meta.title} description={c.meta.description} header="transparent" image={img.og} jsonLd={businessJsonLd(lang)}>
  <Hero image={img.hero} alt={lang === 'en' ? 'The terrace at Casa Club Camposol overlooking the golf course' : 'La terraza de Casa Club Camposol con vistas al campo de golf'}
    eyebrow={c.hero.eyebrow} title={c.hero.title} sub={c.hero.sub}
    cta1={{ href: site.whatsappHref, label: c.hero.cta1, icon: 'whatsapp' }}
    cta2={{ href: localePath(lang, '/events/'), label: c.hero.cta2, icon: 'calendar' }} />

  <!-- Info strip -->
  <div class="container-x -mt-10 relative z-10">
    <div class="card grid gap-5 p-6 sm:grid-cols-2 lg:grid-cols-4 lg:p-8">
      {c.strip.map((s) => (
        <div class="flex items-start gap-3">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-green-50 text-green-800"><Icon name={s.icon} size={20} /></span>
          <div><p class="text-xs font-semibold uppercase tracking-widest text-ink-500">{s.label}</p><p class="mt-0.5 font-semibold text-green-950">{s.value}</p></div>
        </div>
      ))}
    </div>
  </div>

  <!-- Pillars -->
  <Section eyebrow={c.pillars.eyebrow} title={c.pillars.title} intro={c.pillars.intro} align="center">
    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {c.pillars.items.map((p, i) => (
        <a href={localePath(lang, p.href)} class="card reveal group relative flex flex-col overflow-hidden p-8 hover:-translate-y-1 hover:shadow-soft" style={`transition-delay:${i * 90}ms`}>
          <span class="grid h-12 w-12 place-items-center rounded-full bg-sol-100 text-sol-600 transition group-hover:bg-sol-500 group-hover:text-white"><Icon name={p.icon} size={22} /></span>
          <h3 class="mt-6 text-2xl text-green-950">{p.title}</h3>
          <p class="mt-3 flex-1 leading-relaxed text-ink-500">{p.text}</p>
          <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-green-800">{p.cta} <Icon name="arrow" size={16} class="transition group-hover:translate-x-1" /></span>
        </a>
      ))}
    </div>
  </Section>

  <!-- Restaurant feature -->
  <section class="bg-green-950 text-white">
    <div class="grid lg:grid-cols-2">
      <div class="relative min-h-[360px] lg:min-h-[640px]"><img src={img.food} alt="" class="img-cover absolute inset-0" loading="lazy" decoding="async" /></div>
      <div class="flex items-center px-6 py-16 sm:px-12 lg:px-16 lg:py-24">
        <div class="reveal max-w-xl">
          <p class="eyebrow text-sol-300">{c.restaurant.eyebrow}</p>
          <h2 class="mt-3 text-3xl font-medium leading-tight sm:text-5xl">{c.restaurant.title}</h2>
          <p class="mt-5 text-lg leading-relaxed text-sand-200/85">{c.restaurant.text}</p>
          <ul class="mt-7 grid gap-3 sm:grid-cols-2">
            {c.restaurant.points.map((p) => <li class="flex items-start gap-2.5 text-sand-100"><Icon name="check" size={18} class="mt-0.5 shrink-0 text-sol-400" /><span>{p}</span></li>)}
          </ul>
          <a href={localePath(lang, '/restaurant/')} class="btn-accent mt-9">{c.restaurant.cta} <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Week -->
  <Section eyebrow={c.week.eyebrow} title={c.week.title} intro={c.week.intro} class="bg-sand-100">
    <WeekGrid days={c.week.days} note={c.week.note} />
  </Section>

  <!-- Golf feature -->
  <section class="py-16 sm:py-24">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal order-2 lg:order-1">
        <p class="eyebrow">{c.golf.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-medium leading-tight text-green-950 sm:text-5xl">{c.golf.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-500">{c.golf.text}</p>
        <dl class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
          {c.golf.stats.map((s) => <div><dt class="font-display text-3xl text-green-800">{s.v}</dt><dd class="mt-1 text-xs font-semibold uppercase tracking-wider text-ink-500">{s.l}</dd></div>)}
        </dl>
        <a href={localePath(lang, '/golf/')} class="btn-primary mt-9">{c.golf.cta} <Icon name="arrow" size={16} /></a>
      </div>
      <div class="reveal order-1 grid grid-cols-2 gap-4 lg:order-2">
        <div class="col-span-2 aspect-[16/10] overflow-hidden rounded-xl2 shadow-card"><img src={img.course} alt="" class="img-cover" loading="lazy" decoding="async" /></div>
        <div class="aspect-square overflow-hidden rounded-xl2 shadow-card"><img src={img.course2} alt="" class="img-cover" loading="lazy" decoding="async" /></div>
        <div class="aspect-square overflow-hidden rounded-xl2 shadow-card"><img src={img.buggies} alt="" class="img-cover" loading="lazy" decoding="async" /></div>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <Section eyebrow={c.reviews.eyebrow} title={c.reviews.title} align="center" class="bg-sand-100">
    <Testimonials items={c.reviews.items} />
  </Section>

  <!-- Functions -->
  <section class="py-16 sm:py-24">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal relative aspect-[4/3] overflow-hidden rounded-xl2 shadow-card">
        <img src={img.events} alt="" class="img-cover" loading="lazy" decoding="async" />
      </div>
      <div class="reveal">
        <p class="eyebrow">{c.functions.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-medium leading-tight text-green-950 sm:text-5xl">{c.functions.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-500">{c.functions.text}</p>
        <ul class="mt-7 grid gap-3 sm:grid-cols-2">
          {c.functions.points.map((p) => <li class="flex items-start gap-2.5"><Icon name="check" size={18} class="mt-0.5 shrink-0 text-sol-500" /><span>{p}</span></li>)}
        </ul>
        <a href={localePath(lang, '/contact/')} class="btn-outline mt-9">{c.functions.cta} <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- Visit -->
  <Section eyebrow={c.visit.eyebrow} title={c.visit.title} intro={c.visit.text} class="bg-sand-100">
    <div class="mt-12 grid gap-8 lg:grid-cols-5">
      <div class="lg:col-span-3"><MapLeaflet height="100%" class="min-h-[380px]" /></div>
      <div class="card reveal p-7 lg:col-span-2">
        <address class="not-italic leading-relaxed text-ink-700">
          {site.address.lines.map((l) => <span class="block">{l}</span>)}
        </address>
        <ul class="mt-6 divide-y divide-ink-900/5">
          {c.visit.distances.map((d) => <li class="flex items-center justify-between py-2.5 text-sm"><span class="flex items-center gap-2 text-ink-700"><Icon name={d.place.toLowerCase().includes('airport') || d.place.toLowerCase().includes('aeropuerto') ? 'plane' : 'car'} size={16} class="text-ink-300" /> {d.place}</span><span class="font-semibold text-green-800">{d.time}</span></li>)}
        </ul>
        <a href={localePath(lang, '/contact/')} class="btn-primary mt-7 w-full">{c.visit.cta}</a>
      </div>
    </div>
  </Section>

  <CtaBand title={c.band.title} text={c.band.text} cta1={c.band.cta1} cta2={c.band.cta2} image={img.terrace} />
</Base>
