---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import TodayCard from '../components/TodayCard.astro';
import Timetable from '../components/Timetable.astro';
import Testimonials from '../components/Testimonials.astro';
import CheckList from '../components/CheckList.astro';
import MapLeaflet from '../components/MapLeaflet.astro';
import { home } from '../content/home';
import { img } from '../data/images';
import { site } from '../data/site';
import { localePath, useTranslations, type Lang } from '../i18n/utils';
import { businessJsonLd } from '../data/jsonld';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = home[lang];
const t = useTranslations(lang);
const enquiry = (type: string) => `${localePath(lang, '/contact/')}?type=${type}#enquiry`;
// Bento of the four things people come for; the first tile is the big one on desktop.
const tileImages = [img.food, img.heroGolf, img.events, img.party];
const tileLayout = ['lg:col-span-2 lg:row-span-2', 'lg:col-span-2', '', ''];
---
<Base title={c.meta.title} description={c.meta.description} image={img.og} jsonLd={businessJsonLd(lang)}>
  <!-- Hero: one portrait photo on phones, a strip of three (terrace, course, live music) on desktop -->
  <section class="on-dark relative isolate flex min-h-[100svh] items-end overflow-hidden bg-pine-950 text-cream-50 lg:min-h-[min(100svh,60rem)]">
    <div class="absolute inset-0 -z-20 grid gap-1 sm:grid-cols-2 lg:grid-cols-3">
      <div class="overflow-hidden"><img src={img.restaurant} alt={c.hero.alt} class="img-cover hero-photo" fetchpriority="high" decoding="async" /></div>
      <div class="hidden overflow-hidden sm:block"><img src={img.golfPortrait} alt="" class="img-cover hero-photo" loading="lazy" decoding="async" /></div>
      <div class="hidden overflow-hidden lg:block"><img src={img.heroEvents} alt="" class="img-cover hero-photo" loading="lazy" decoding="async" /></div>
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-pine-950 via-pine-950/60 to-pine-950/0"></div>
    <div class="absolute inset-x-0 top-0 -z-10 h-44 bg-gradient-to-b from-pine-950/70 to-transparent"></div>

    <div class="container-x grid gap-8 pb-8 pt-40 sm:pb-12 lg:grid-cols-12 lg:items-end lg:gap-10 lg:pb-16">
      <div class="lg:col-span-8">
        <p class="eyebrow rise">{c.hero.eyebrow}</p>
        <h1 class="h-hero rise mt-5 max-w-4xl" style="--i:1">{c.hero.title}</h1>
        <p class="lede rise mt-6 max-w-xl" style="--i:2">{c.hero.sub}</p>
        <div class="rise mt-8 flex flex-wrap gap-3" style="--i:3">
          <a href={enquiry('table')} data-book class="btn-primary">{c.hero.cta1} <Icon name="arrow" size={17} /></a>
          <a href={localePath(lang, '/events/')} class="btn-glass"><Icon name="calendar" size={17} /> {c.hero.cta2}</a>
        </div>
      </div>
      <TodayCard lang={lang} class="rise lg:col-span-4" style="--i:4" />
    </div>
  </section>

  <!-- What we offer -->
  <section class="container-x section-y">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <SectionHeading eyebrow={c.intro.eyebrow} title={c.intro.title} class="lg:col-span-6" />
      <p class="lede reveal lg:col-span-6">{c.intro.text}</p>
    </div>
    <ul class="snap-row mt-12 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-4 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-4 lg:grid-rows-[repeat(2,18rem)]">
      {c.experiences.map((x, i) => (
        <li class:list={['w-[80%] sm:w-auto', tileLayout[i]]}>
          <a href={localePath(lang, x.href)} class="group relative isolate flex aspect-[3/4] h-full flex-col overflow-hidden rounded-[var(--radius-card)] bg-pine-900 text-cream-50 sm:aspect-auto sm:min-h-[20rem] lg:min-h-0">
            <img src={tileImages[i]} alt={x.alt} class="img-cover absolute inset-0 -z-10 transition duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-pine-950/90 via-pine-950/30 to-transparent"></div>
            <span class="glass absolute right-4 top-4 grid h-11 w-11 place-items-center rounded-full transition-colors group-hover:bg-cream-50 group-hover:text-pine-950"><Icon name="arrow" size={18} /></span>
            <div class="mt-auto p-6 sm:p-7">
              <h3 class:list={['font-extrabold tracking-tight', i === 0 ? 'text-3xl lg:text-4xl' : 'text-2xl']}>{x.title}</h3>
              <p class="mt-2 max-w-sm text-[0.9375rem] leading-relaxed text-cream-50/80">{x.text}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- This week -->
  <section id="week" class="on-dark section-y bg-pine-950 text-cream-50">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <SectionHeading eyebrow={c.week.eyebrow} title={c.week.title} intro={c.week.intro} />
        <a href={localePath(lang, '/events/')} class="btn-glass">{c.week.cta} <Icon name="arrow" size={16} /></a>
      </div>
      <Timetable lang={lang} tone="dark" note={c.week.note} />
    </div>
  </section>

  <!-- Restaurant -->
  <section class="container-x section-y grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="reveal relative lg:col-span-7">
      <div class="frame aspect-[4/5] bg-cream-200 sm:aspect-[4/3]"><img src={img.terrace} alt={c.restaurant.alt} class="img-cover" loading="lazy" decoding="async" /></div>
      <p class="absolute bottom-4 left-4 inline-flex items-center gap-2 rounded-full bg-cream-50/95 px-4 py-2.5 text-sm font-semibold text-pine-950 shadow-lg sm:bottom-6 sm:left-6"><Icon name="clock" size={16} class="text-clay-600" /> {c.restaurant.badge}</p>
    </div>
    <div class="lg:col-span-5">
      <SectionHeading eyebrow={c.restaurant.eyebrow} title={c.restaurant.title} intro={c.restaurant.text} />
      <ul class="reveal mt-8 grid gap-3 sm:grid-cols-2">
        {c.restaurant.signatures.map((s) => (
          <li class="rounded-2xl border border-ink-950/8 bg-white p-4">
            <p class="text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-clay-700">{s.when}</p>
            <p class="mt-1.5 font-bold text-pine-950">{s.name}</p>
            <p class="mt-0.5 text-sm text-ink-600">{s.desc}</p>
          </li>
        ))}
      </ul>
      <a href={localePath(lang, '/restaurant/')} class="btn-dark mt-8">{c.restaurant.cta} <Icon name="arrow" size={16} /></a>
    </div>
  </section>

  <!-- Golf -->
  <section class="on-dark relative isolate overflow-hidden bg-pine-950 text-cream-50">
    <img src={img.course} alt="" class="img-cover absolute inset-0 -z-10" loading="lazy" decoding="async" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-pine-950 via-pine-950/70 to-pine-950/30 lg:bg-gradient-to-r lg:from-pine-950/95 lg:via-pine-950/70 lg:to-pine-950/10"></div>
    <div class="container-x grid gap-12 py-20 sm:py-28 lg:grid-cols-12 lg:items-end lg:py-36">
      <div class="lg:col-span-6">
        <SectionHeading eyebrow={c.golf.eyebrow} title={c.golf.title} intro={c.golf.text} />
        <a href={localePath(lang, '/golf/')} class="btn-light mt-9">{c.golf.cta} <Icon name="arrow" size={16} /></a>
      </div>
      <dl class="glass reveal grid grid-cols-2 overflow-hidden rounded-[var(--radius-card)] lg:col-span-5 lg:col-start-8">
        {c.golf.stats.map((s) => (
          <div class="p-6 sm:p-7"><dt class="whitespace-nowrap text-[1.9rem] font-extrabold leading-none tracking-[-0.04em] sm:text-[2.75rem]">{s.v}</dt><dd class="mt-2 text-xs font-semibold uppercase tracking-[0.14em] text-cream-50/70">{s.l}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Reviews -->
  <Section eyebrow={c.reviews.eyebrow} title={c.reviews.title} class="bg-cream-100">
    <Testimonials items={c.reviews.items} />
  </Section>

  <!-- Private hire -->
  <section class="container-x section-y grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <SectionHeading eyebrow={c.functions.eyebrow} title={c.functions.title} intro={c.functions.text} />
      <CheckList items={c.functions.points} class="reveal mt-8" />
      <a href={enquiry('event')} class="btn-dark mt-9">{c.functions.cta} <Icon name="arrow" size={16} /></a>
    </div>
    <div class="reveal relative lg:col-span-7">
      <div class="frame aspect-[4/5] bg-cream-200 sm:aspect-[4/3]"><img src={img.functionRoom} alt={c.functions.alt} class="img-cover" loading="lazy" decoding="async" /></div>
      <p class="glass absolute bottom-4 left-4 rounded-full px-4 py-2.5 text-sm font-semibold text-white sm:bottom-6 sm:left-6">{c.functions.chip}</p>
    </div>
  </section>

  <!-- Visit: the map with the address card floating over it on desktop, below it on phones
       (so the card never covers the map credits) -->
  <Section eyebrow={c.visit.eyebrow} title={c.visit.title} intro={c.visit.text} class="!pt-0">
    <div class="relative mt-12 lg:h-[36rem]">
      <MapLeaflet lang={lang} class="h-80 sm:h-[26rem] lg:absolute lg:inset-0 lg:h-auto" />
      <div class="relative z-10 mt-4 rounded-[var(--radius-card)] border border-ink-950/8 bg-white p-6 sm:p-8 lg:absolute lg:left-6 lg:top-6 lg:m-0 lg:w-[24rem] lg:border-0 lg:shadow-2xl lg:shadow-pine-950/15">
        <address class="text-lg font-bold not-italic leading-snug text-pine-950">
          {site.address.lines.slice(0, 3).map((l) => <span class="block">{l}</span>)}
        </address>
        <ul class="mt-5 divide-y divide-ink-950/8 border-y border-ink-950/8">
          {c.visit.distances.map((d) => (
            <li class="flex items-center justify-between gap-4 py-3 text-[0.9375rem]">
              <span class="flex items-center gap-3 text-ink-800"><Icon name={d.icon} size={17} class="text-ink-400" /> {d.place}</span>
              <span class="shrink-0 whitespace-nowrap font-bold tabular-nums text-pine-800">{d.time}</span>
            </li>
          ))}
        </ul>
        <div class="mt-6 grid gap-3">
          <a href={site.directionsUrl} target="_blank" rel="noopener" class="btn-primary"><Icon name="navigation" size={16} /> {t('cta.directions')}</a>
          <a href={localePath(lang, '/contact/')} class="link-arrow justify-center">{c.visit.cta} <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </Section>
</Base>
