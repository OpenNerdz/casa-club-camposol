---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import TodayCard from '../components/TodayCard.astro';
import Timetable from '../components/Timetable.astro';
import Testimonials from '../components/Testimonials.astro';
import CheckList from '../components/CheckList.astro';
import MapLeaflet from '../components/MapLeaflet.astro';
import { home } from '../content/home';
import { img } from '../data/images';
import { site } from '../data/site';
import { localePath, useTranslations, type Lang } from '../i18n/utils';
import { businessJsonLd } from '../data/jsonld';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = home[lang];
const t = useTranslations(lang);
const enquiry = (type: string) => `${localePath(lang, '/contact/')}?type=${type}#enquiry`;
---
<Base title={c.meta.title} description={c.meta.description} image={img.og} jsonLd={businessJsonLd(lang)}>
  <!-- Hero -->
  <section class="container-x grid gap-14 pb-20 pt-28 sm:pt-36 lg:grid-cols-12 lg:gap-10 lg:pb-24 lg:pt-36">
    <div class="lg:col-span-7 lg:pt-8">
      <p class="eyebrow">{c.hero.eyebrow}</p>
      <h1 class="h-display mt-5 text-pine-950">{c.hero.title}</h1>
      <p class="lede mt-7 max-w-xl">{c.hero.sub}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={enquiry('table')} data-book class="btn-primary">{c.hero.cta1} <Icon name="arrow" size={17} /></a>
        <a href={localePath(lang, '/events/')} class="btn-line"><Icon name="calendar" size={17} /> {c.hero.cta2}</a>
      </div>
      <TodayCard lang={lang} class="mt-12 max-w-md" />
    </div>

    <div class="mx-auto w-full max-w-md self-start lg:col-span-5 lg:max-w-none">
      <div class="frame aspect-[4/5] bg-cream-200">
        <img src={img.restaurant} alt={c.hero.alt} class="img-cover" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="container-x grid gap-6 border-t border-ink-950/10 py-20 sm:py-24 lg:grid-cols-12">
    <p class="eyebrow lg:col-span-3 lg:mt-2">{c.intro.eyebrow}</p>
    <div class="reveal lg:col-span-9">
      <p class="text-[clamp(1.45rem,1.2rem+1vw,2.1rem)] font-semibold leading-snug tracking-[-0.02em] text-pine-950">{c.intro.text}</p>
      <ul class="mt-10 flex flex-wrap gap-3">
        {c.intro.links.map((l) => (
          <li><a href={localePath(lang, l.href)} class="group inline-flex h-12 items-center gap-2 rounded-full border border-ink-950/15 px-5 font-semibold text-pine-900 transition-colors hover:border-pine-900 hover:bg-pine-900 hover:text-cream-50">
            {l.label} <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-0.5" /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- This week -->
  <section id="week" class="on-dark bg-pine-950 py-20 text-cream-50 sm:py-28">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <SectionHeading eyebrow={c.week.eyebrow} title={c.week.title} intro={c.week.intro} />
        <a href={localePath(lang, '/events/')} class="btn-ghost">{c.week.cta} <Icon name="arrow" size={16} /></a>
      </div>
      <Timetable lang={lang} tone="dark" note={c.week.note} />
    </div>
  </section>

  <!-- Restaurant -->
  <section class="container-x grid gap-12 py-20 sm:py-28 lg:grid-cols-12 lg:items-center lg:gap-20">
    <div class="reveal mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none">
      <div class="frame aspect-[4/5] bg-cream-200"><img src={img.food} alt={c.restaurant.alt} class="img-cover" loading="lazy" decoding="async" /></div>
    </div>
    <div class="lg:col-span-7">
      <SectionHeading eyebrow={c.restaurant.eyebrow} title={c.restaurant.title} intro={c.restaurant.text} />
      <dl class="reveal mt-10 border-b border-ink-950/12">
        {c.restaurant.signatures.map((s) => (
          <div class="grid grid-cols-[1fr_auto] items-baseline gap-x-6 border-t border-ink-950/12 py-4">
            <dt class="text-lg font-bold text-pine-950">{s.name}</dt>
            <dd class="text-xs font-semibold uppercase tracking-[0.14em] text-clay-700">{s.when}</dd>
            <dd class="col-span-2 mt-0.5 text-ink-600">{s.desc}</dd>
          </div>
        ))}
      </dl>
      <a href={localePath(lang, '/restaurant/')} class="btn-dark mt-10">{c.restaurant.cta} <Icon name="arrow" size={16} /></a>
    </div>
  </section>

  <!-- Golf -->
  <section class="on-dark relative isolate overflow-hidden bg-pine-950 text-cream-50">
    <img src={img.course} alt="" class="img-cover absolute inset-0 -z-10 opacity-60" loading="lazy" decoding="async" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-pine-950 via-pine-950/80 to-pine-950/20"></div>
    <div class="container-x py-24 sm:py-32">
      <div class="max-w-2xl">
        <SectionHeading eyebrow={c.golf.eyebrow} title={c.golf.title} intro={c.golf.text} />
        <a href={localePath(lang, '/golf/')} class="btn-light mt-10">{c.golf.cta} <Icon name="arrow" size={16} /></a>
      </div>
      <dl class="reveal mt-16 grid max-w-4xl grid-cols-2 gap-x-8 gap-y-10 border-t border-cream-50/15 pt-10 sm:grid-cols-4">
        {c.golf.stats.map((s) => (
          <div><dt class="text-[2.5rem] font-bold leading-none tracking-[-0.03em] text-cream-50">{s.v}</dt><dd class="mt-2 text-xs font-semibold uppercase tracking-[0.14em] text-cream-50/65">{s.l}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Reviews -->
  <Section eyebrow={c.reviews.eyebrow} title={c.reviews.title}>
    <Testimonials items={c.reviews.items} />
  </Section>

  <!-- Private hire -->
  <section class="bg-cream-100 py-20 sm:py-28">
    <div class="container-x grid gap-14 lg:grid-cols-12 lg:items-center lg:gap-20">
      <div class="reveal grid grid-cols-2 gap-4 lg:order-2 lg:col-span-6">
        <div class="frame aspect-[3/4] bg-cream-200"><img src={img.events} alt={c.functions.alt} class="img-cover" loading="lazy" decoding="async" /></div>
        <div class="frame aspect-[3/4] bg-cream-200"><img src={img.heroEvents} alt="" class="img-cover" loading="lazy" decoding="async" /></div>
      </div>
      <div class="lg:col-span-6">
        <SectionHeading eyebrow={c.functions.eyebrow} title={c.functions.title} intro={c.functions.text} />
        <CheckList items={c.functions.points} columns={2} class="reveal mt-8" />
        <a href={enquiry('event')} class="btn-dark mt-10">{c.functions.cta} <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- Visit -->
  <Section eyebrow={c.visit.eyebrow} title={c.visit.title} intro={c.visit.text}>
    <div class="mt-14 grid gap-6 lg:grid-cols-12">
      <MapLeaflet lang={lang} class="min-h-[22rem] lg:col-span-8 lg:min-h-[32rem]" />
      <div class="panel flex flex-col p-7 sm:p-8 lg:col-span-4">
        <address class="text-lg font-semibold not-italic leading-snug text-pine-950">
          {site.address.lines.slice(0, 3).map((l) => <span class="block">{l}</span>)}
        </address>
        <ul class="mt-6 divide-y divide-ink-950/10 border-y border-ink-950/10">
          {c.visit.distances.map((d) => (
            <li class="flex items-center justify-between gap-4 py-3 text-[0.9375rem]">
              <span class="flex items-center gap-3 text-ink-800"><Icon name={d.icon} size={17} class="text-ink-400" /> {d.place}</span>
              <span class="font-semibold tabular-nums text-pine-800">{d.time}</span>
            </li>
          ))}
        </ul>
        <div class="mt-auto grid gap-4 pt-8">
          <a href={site.directionsUrl} target="_blank" rel="noopener" class="btn-dark"><Icon name="navigation" size={16} /> {t('cta.directions')}</a>
          <a href={localePath(lang, '/contact/')} class="link-arrow justify-center">{c.visit.cta} <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </Section>
</Base>
