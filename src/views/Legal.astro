---
import Base from '../layouts/Base.astro';
import { legal, privacy } from '../content/legal';
import { site } from '../data/site';
import { type Lang } from '../i18n/utils';
interface Props { lang: Lang; kind: 'legal' | 'privacy' }
const { lang, kind } = Astro.props;
const c = (kind === 'legal' ? legal : privacy)[lang];
const fill = (s: string) => s
  .replace('{legalName}', site.legalName).replace('{cif}', site.cif).replace('{address}', site.address.lines.slice(0, 3).join(', '))
  .replace('{registry}', site.registry).replace('{email}', site.email).replace('{phone}', site.phoneDisplay);
---
<Base title={c.meta.title} description={c.meta.description} noindex>
  <section class="container-x max-w-3xl pb-8 pt-32 sm:pt-40">
    <p class="eyebrow">{site.name}</p>
    <h1 class="mt-3 text-4xl font-medium text-green-950 sm:text-5xl">{c.title}</h1>
    <div class="prose-custom mt-10 space-y-10">
      {c.sections.map((s) => (
        <section>
          <h2 class="text-2xl text-green-950">{s.h}</h2>
          {s.p.map((p) => <p class="mt-3 leading-relaxed text-ink-700">{fill(p)}</p>)}
          {'list' in s && <ul class="mt-3 list-disc space-y-1 pl-6 text-ink-700">{s.list!.map((l) => <li>{fill(l)}</li>)}</ul>}
        </section>
      ))}
    </div>
    <p class="mt-12 text-sm text-ink-500">{lang === 'en' ? 'Last updated: October 2026.' : 'Última actualización: octubre de 2026.'}</p>
  </section>
</Base>
