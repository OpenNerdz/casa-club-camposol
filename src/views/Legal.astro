---
import Base from '../layouts/Base.astro';
import { legal, privacy } from '../content/legal';
import { site } from '../data/site';
import { type Lang } from '../i18n/utils';
interface Props { lang: Lang; kind: 'legal' | 'privacy' }
const { lang, kind } = Astro.props;
const c = (kind === 'legal' ? legal : privacy)[lang];
const fill = (s: string) => s
  .replaceAll('{legalName}', site.legalName).replaceAll('{cif}', site.cif).replaceAll('{address}', site.address.lines.slice(0, 3).join(', '))
  .replaceAll('{registry}', site.registry).replaceAll('{email}', site.email).replaceAll('{phone}', site.phoneDisplay);
---
<Base title={c.meta.title} description={c.meta.description} noindex tone="light">
  <article class="container-x max-w-3xl pb-20 pt-28 sm:pb-28 sm:pt-36 lg:pt-40">
    <p class="eyebrow">{site.name}</p>
    <h1 class="h-section mt-5 text-pine-950">{c.title}</h1>
    <div class="prose-legal mt-4">
      {c.sections.map((s) => (
        <section>
          <h2>{s.h}</h2>
          {s.p.map((p) => <p>{fill(p)}</p>)}
          {'list' in s && <ul>{s.list!.map((l) => <li>{fill(l)}</li>)}</ul>}
        </section>
      ))}
    </div>
    <p class="mt-14 border-t border-ink-950/12 pt-6 text-sm text-ink-600">{c.updated}</p>
  </article>
</Base>
