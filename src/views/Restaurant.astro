---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { restaurant } from '../content/restaurant';
import { img } from '../data/images';
import { site } from '../data/site';
import { type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = restaurant[lang];
---
<Base title={c.meta.title} description={c.meta.description} header="transparent" image={img.food}>
  <Hero image={img.restaurant} compact eyebrow={c.hero.eyebrow} title={c.hero.title} sub={c.hero.sub}
    cta1={{ href: site.whatsappHref, label: c.booking.cta1, icon: 'whatsapp' }} />

  <section class="py-16 sm:py-24">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal">
        <p class="eyebrow">{c.intro.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-medium leading-tight text-green-950 sm:text-5xl">{c.intro.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-500">{c.intro.text}</p>
      </div>
      <div class="reveal grid grid-cols-2 gap-4">
        <div class="aspect-[3/4] overflow-hidden rounded-xl2 shadow-card"><img src={img.food} alt="" class="img-cover" loading="lazy" decoding="async" /></div>
        <div class="mt-8 aspect-[3/4] overflow-hidden rounded-xl2 shadow-card"><img src={img.bar} alt="" class="img-cover" loading="lazy" decoding="async" /></div>
      </div>
    </div>
  </section>

  <Section class="bg-sand-100" title={lang === 'en' ? 'A day at the clubhouse' : 'Un día en la casa club'} eyebrow={lang === 'en' ? 'From dawn to dusk' : 'De la mañana a la noche'}>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {c.moments.map((m, i) => (
        <div class="card reveal p-7" style={`transition-delay:${(i % 3) * 90}ms`}>
          <span class="grid h-11 w-11 place-items-center rounded-full bg-green-50 text-green-800"><Icon name={m.icon} size={20} /></span>
          <h3 class="mt-5 text-xl text-green-950">{m.title}</h3>
          <p class="mt-2 leading-relaxed text-ink-500">{m.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow={c.favourites.eyebrow} title={c.favourites.title} intro={c.favourites.text}>
    <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {c.favourites.groups.map((g) => (
        <div class="reveal">
          <h3 class="border-b-2 border-sol-400 pb-2 font-display text-2xl text-green-950">{g.title}</h3>
          <ul class="mt-4 space-y-2.5 text-ink-700">{g.items.map((it) => <li class="flex gap-2"><span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-sol-500"></span>{it}</li>)}</ul>
        </div>
      ))}
    </div>
    <p class="mt-10 rounded-xl2 bg-green-50 p-5 text-sm text-green-900">{c.favourites.note}</p>
  </Section>

  <section class="container-x grid gap-6 pb-8 lg:grid-cols-3">
    <div class="card reveal p-8 lg:col-span-2">
      <h2 class="text-3xl text-green-950">{c.booking.title}</h2>
      <p class="mt-3 text-lg text-ink-500">{c.booking.text}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={site.whatsappHref} class="btn-accent" target="_blank" rel="noopener"><Icon name="whatsapp" size={16} /> {c.booking.cta1}</a>
        <a href={site.phoneHref} class="btn-outline"><Icon name="phone" size={16} /> {c.booking.cta2}</a>
      </div>
    </div>
    <div class="card reveal p-8">
      <h2 class="text-2xl text-green-950">{c.hoursTitle}</h2>
      <ul class="mt-4 space-y-2 text-sm">{site.hours[lang].map((h) => <li class="flex justify-between gap-4 border-b border-ink-900/5 pb-2"><span class="text-ink-500">{h.label}</span><span class="font-semibold text-green-950">{h.value}</span></li>)}</ul>
    </div>
  </section>

  <CtaBand title={lang === 'en' ? 'Table for two, or twenty?' : '¿Mesa para dos, o para veinte?'} text={lang === 'en' ? 'Private dining, society lunches and celebrations are our speciality.' : 'Comidas privadas, almuerzos de sociedades y celebraciones son nuestra especialidad.'} cta1={lang === 'en' ? 'WhatsApp us' : 'Escríbenos por WhatsApp'} cta2={lang === 'en' ? 'Call us' : 'Llámanos'} image={img.terrace} />
</Base>
