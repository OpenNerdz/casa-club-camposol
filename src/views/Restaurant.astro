---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import HoursList from '../components/HoursList.astro';
import Icon from '../components/Icon.astro';
import { restaurant } from '../content/restaurant';
import { img } from '../data/images';
import { site, whatsappBookingHref } from '../data/site';
import { localePath, useTranslations, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = restaurant[lang];
const t = useTranslations(lang);
// Breakfast, menú del día and fish & chips as light cards, the carvery in pine, the terrace and evenings as photos.
const light = 'bg-white text-pine-950 border border-ink-950/8';
const momentTone = [light, light, light, 'bg-pine-900 text-cream-50', 'text-cream-50', 'text-cream-50'];
const momentPhotos = [undefined, undefined, undefined, undefined, img.restaurant, img.bar];
---
<Base title={c.meta.title} description={c.meta.description} image={img.ogRestaurant}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} sub={c.hero.sub} image={img.terrace} alt={c.alts.hero}
    cta1={{ href: `${localePath(lang, '/contact/')}?type=table#enquiry`, label: t('cta.book'), book: true }}
    cta2={{ href: site.phoneHref, label: c.booking.cta2, icon: 'phone' }} />

  <!-- The kitchen -->
  <section class="container-x section-y grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-20">
    <div class="lg:col-span-6">
      <SectionHeading eyebrow={c.intro.eyebrow} title={c.intro.title} intro={c.intro.text} />
    </div>
    <div class="reveal grid grid-cols-2 gap-4 lg:col-span-6">
      <div class="frame aspect-[3/4] bg-cream-200"><img src={img.sunsetPalm} alt={c.alts.food} class="img-cover" loading="lazy" decoding="async" /></div>
      <div class="frame aspect-[3/4] bg-cream-200"><img src={img.bar} alt={c.alts.bar} class="img-cover" loading="lazy" decoding="async" /></div>
    </div>
  </section>

  <!-- A day at the clubhouse: colour and photo cards in a bento grid -->
  <Section eyebrow={c.day.eyebrow} title={c.day.title} class="bg-cream-100">
    <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {c.moments.map((m, i) => {
        const photo = momentPhotos[i];
        return (
          <li class:list={['reveal relative isolate flex flex-col overflow-hidden rounded-[var(--radius-card)] p-7 sm:min-h-[15rem]', photo && 'min-h-[14rem]', momentTone[i]]} style={`transition-delay:${(i % 3) * 80}ms`}>
            {photo && <><img src={photo} alt="" class="img-cover absolute inset-0 -z-10" loading="lazy" decoding="async" /><div class="absolute inset-0 -z-10 bg-gradient-to-t from-pine-950/95 via-pine-950/75 to-pine-950/50"></div></>}
            <p class:list={['text-xs font-bold uppercase tracking-[0.14em]', momentTone[i] === light ? 'text-clay-700' : 'opacity-90']}>{m.when}</p>
            <h3 class="mt-auto pt-5 text-2xl font-extrabold tracking-tight sm:pt-10">{m.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed opacity-95">{m.text}</p>
          </li>
        );
      })}
    </ol>
  </Section>

  <!-- Menus: the daily menu is posted on Facebook; allergy and group-menu notes alongside -->
  <section class="on-dark section-y bg-pine-950 text-cream-50">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="lg:col-span-7">
        <SectionHeading eyebrow={c.menus.eyebrow} title={c.menus.title} intro={c.menus.text} />
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={site.social.facebook} target="_blank" rel="noopener" class="btn-light"><Icon name="facebook" size={16} /> {c.menus.cta}</a>
          <a href={whatsappBookingHref(lang)} target="_blank" rel="noopener" class="btn-glass"><Icon name="whatsapp" size={16} /> {c.booking.cta1}</a>
        </div>
      </div>
      <div class="reveal grid gap-4 lg:col-span-5">
        <div class="glass rounded-[var(--radius-card)] p-7">
          <h3 class="flex items-center gap-2.5 text-lg"><Icon name="heart" size={18} class="shrink-0 text-ochre-300" /> {c.menus.allergyTitle}</h3>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-cream-50/75">{c.menus.allergy}</p>
        </div>
        <div class="glass rounded-[var(--radius-card)] p-7">
          <h3 class="flex items-center gap-2.5 text-lg"><Icon name="users" size={18} class="shrink-0 text-ochre-300" /> {c.menus.groupsTitle}</h3>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-cream-50/75">{c.menus.groups}</p>
          <a href={`${localePath(lang, '/contact/')}?type=event#enquiry`} class="mt-4 inline-flex items-center gap-1.5 text-[0.9375rem] font-semibold text-ochre-300 hover:text-ochre-100">{c.menus.groupsCta} <Icon name="arrow" size={15} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Booking & hours -->
  <section class="container-x section-y grid gap-5 lg:grid-cols-12">
    <div class="relative isolate overflow-hidden rounded-[var(--radius-card)] bg-clay-600 p-8 text-white sm:p-12 lg:col-span-7">
      <div class="absolute -right-24 -top-24 -z-10 h-72 w-72 rounded-full bg-white/10 blur-2xl"></div>
      <h2 class="h-section">{c.booking.title}</h2>
      <p class="mt-5 max-w-xl text-lg text-white/85">{c.booking.text}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={whatsappBookingHref(lang)} target="_blank" rel="noopener" class="btn-light"><Icon name="whatsapp" size={17} /> {c.booking.cta1}</a>
        <a href={site.phoneHref} class="btn-glass"><Icon name="phone" size={17} /> {site.phoneDisplay}</a>
      </div>
    </div>
    <div class="rounded-[var(--radius-card)] border border-ink-950/8 bg-white p-8 sm:p-10 lg:col-span-5">
      <h3 class="flex items-center gap-2 text-xl text-pine-950"><Icon name="clock" size={20} class="text-clay-600" /> {c.hoursTitle}</h3>
      <HoursList lang={lang} class="mt-4" />
      <p class="mt-4 text-xs text-ink-600">{t('footer.hoursNote')}</p>
    </div>
  </section>
</Base>
